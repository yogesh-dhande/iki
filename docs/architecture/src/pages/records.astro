    <Routes tags={["signatures"]} />
    <Routes paths={/^\/api\/v1\/entities(\/\{ref\})?(\/(states|holds|provenance|making)[^]*)?$/} />
    <div class="refs">
      <div>
        <h3>Where</h3>
        <ul>
          <li><Path p="server/src/iki_server/entities" /></li>
          <li><Path p="server/src/iki_server/signatures" /></li>
          <li><Path p="server/src/iki_server/audit" /></li>
          <li><Path p="codegen/src/iki_codegen/models.py" /></li>
          <li><Path p="server/src/iki_server/plugins/sync.py" /></li>
          <li><Path p="spec/src/iki_spec/rules.py" /></li>
        </ul>
      </div>
      <div>
        <h3>Decisions</h3>
        <ul>
          <li><Adr n="0007" title /></li>
          <li><Adr n="0035" title /></li>
          <li><Adr n="0115" title /></li>
          <li><Adr n="0120" title /></li>
          <li><Adr n="0125" title /></li>
          <li><Adr n="0126" title /></li>
          <li><Adr n="0127" title /></li>
          <li><Adr n="0128" title /></li>
          <li><Adr n="0179" title /></li>
        </ul>
      </div>
      <div>
        <h3>Where the ADRs and code differ</h3>
        <ul>
          <li><Adr n="0007" /> names a <code>PropertyProvenance</code> table; <Adr n="0035" /> dropped it.</li>
          <li><Adr n="0038" /> names <code>iki_plugin_core</code>; the package is <code>iki_plugin_iki__core</code>.</li>
          <li><Adr n="0118" />'s transitions and <Adr n="0119" />'s <code>not_by</code> are superseded by <Adr n="0125" /> and guards.</li>
          <li><Adr n="0120" /> names <code>iki_entity.locked</code>; the column is the <code>locked_by</code> array.</li>
          <li><Adr n="0035" />'s <code>on_duplicate</code> was removed by <Adr n="0115" />.</li>
        </ul>
      </div>
    </div>
  </Layer>
