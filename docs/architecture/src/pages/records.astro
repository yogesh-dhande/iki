---
import Adr from "../components/Adr.astro";
import Diagram from "../components/Diagram.astro";
import Excerpt from "../components/Excerpt.astro";
import Inferred from "../components/Inferred.astro";
import Layer from "../components/Layer.astro";
import Layout from "../components/Layout.astro";
import Path from "../components/Path.astro";
import Routes from "../components/Routes.astro";
import Rule from "../components/Rule.astro";
import Sequence from "../components/Sequence.astro";
import { textChoices } from "../lib/source.ts";

const kinds = textChoices("server/src/iki_server/entities/models.py", "RevisionKind");
const S = "server/src/iki_server/entities/services.py";
const ST = "server/src/iki_server/entities/states.py";

const life = [
  { id: "manifest", x: 20, y: 40, w: 150, h: 60, label: "Type manifest", sub: "a plugin's types/*.yaml" },
  { id: "tables", x: 200, y: 40, w: 150, h: 60, label: "Typed tables", sub: "row, __history, lists" },
  { id: "create", x: 380, y: 40, w: 150, h: 60, label: "Create", sub: "prepare, then write", strong: true },
  { id: "revisions", x: 560, y: 40, w: 150, h: 60, label: "Revisions", sub: "append-only; the ETag" },
  { id: "state", x: 740, y: 40, w: 150, h: 60, label: "Set a state", sub: "set_by, holds, guards" },
  { id: "entry", x: 200, y: 170, w: 150, h: 60, label: "Registry entry", sub: "found by identity" },
  { id: "rules", x: 380, y: 170, w: 150, h: 60, label: "Rules", sub: "CEL at every save" },
  { id: "locked", x: 560, y: 170, w: 150, h: 60, label: "Locked", sub: "a database trigger" },
  { id: "signatures", x: 740, y: 170, w: 150, h: 60, label: "Signatures", sub: "sign in again; Ed25519" },
  { id: "correction", x: 380, y: 300, w: 150, h: 60, label: "Correction", sub: "on_edit, with a reason" },
  { id: "audit", x: 740, y: 300, w: 150, h: 60, label: "Audit log", sub: "append-only events" },
];
const lifeEdges = [
  { from: "manifest", to: "tables" },
  { from: "tables", to: "create" },
  { from: "create", to: "revisions" },
  { from: "revisions", to: "state" },
  { from: "create", to: "entry", label: "identity", dashed: true },
  { from: "create", to: "rules", label: "every save", dashed: true },
  { from: "state", to: "signatures", label: "if signed" },
  { from: "state", to: "locked", label: "locks: true" },
  { from: "signatures", to: "locked", label: "the last one" },
  { from: "locked", to: "correction", label: "an edit" },
  { from: "correction", to: "revisions", label: "back to review", via: [[545, 330], [545, 85]] as [number, number][], at: [545, 280] as [number, number] },
  { from: "signatures", to: "audit", label: "signature.signed" },
];

const reg = [
  { id: "registry", x: 20, y: 30, w: 220, h: 64, label: "Registry", sub: "every project is in one" },
  { id: "entryb", x: 300, y: 30, w: 240, h: 64, label: "Entry", sub: ["the identity: hash, facts,", "values the identity decides"], strong: true },
  { id: "reca", x: 160, y: 160, w: 220, h: 64, label: "Project A's record", sub: "its own fields, accession, HRID" },
  { id: "recb", x: 460, y: 160, w: 220, h: 64, label: "Project B's record", sub: "its own fields, accession, HRID" },
  { id: "registrar", x: 600, y: 30, w: 160, h: 64, label: "Registrars", sub: "curate, supersede" },
];
const regEdges = [
  { from: "registry", to: "entryb", label: "holds" },
  { from: "reca", to: "entryb", label: "entry" },
  { from: "recb", to: "entryb", label: "entry" },
  { from: "registrar", to: "entryb", label: "facts", dashed: true },
];

const H = {
  short: "What a record is",
  how: "From a type manifest to a signed, locked record",
  example: "A plasmid verification's states and rules",
  rules: "Revisions, states, locks, signatures and corrections",
  ref: "Routes, code and decisions",
};
const toc = [
  { id: "short", label: H.short },
  { id: "how", label: H.how },
  { id: "save", label: "One save, step by step" },
  { id: "registries", label: "Registries and project records" },
  { id: "example", label: H.example },
  { id: "rules", label: H.rules },
  { id: "ref", label: H.ref },
];
---

<Layout toc={toc}>
  <Layer n={1} title={H.short}>
    <p>
      A record is a row of a type that a plugin declared. Every change to it is a numbered,
      append-only revision, and the revision number is what a client must name to change it again.
      A type may give it state fields: setting a state is checked by the plugin's guards, may need
      electronic signatures bound to that exact revision, and may lock the record so that the
      database itself refuses to change it. A locked record can be corrected only by returning it,
      with a reason, to a state its plugin names. Records live in projects; what a thing <em>is</em>
      (its identity) lives once, in the registry, as an entry every project's record points to.
    </p>
    <ul>
      <li>One table per type, with a history table beside it (<Adr n={[7, 33]} />).</li>
      <li>Provenance is the revision that last changed a field; there's no separate table (<Adr n="0035" />).</li>
      <li>States, locks, guards and signatures are the plugin's to declare (<Adr n={[125, 128, 126]} />).</li>
      <li>Registries keep identities; each project keeps its own record (<Adr n="0115" />).</li>
    </ul>
  </Layer>

  <Layer n={2} title={H.how}>
    <p>
      A plugin's type manifest is compiled into a Django model and its tables. Creating a record
      checks every value and the plugin's rules, then writes the row, revision 1 and its history in
      one transaction. Each edit is another revision. A state field is never set by an edit: it's
      set on its own, by someone with a role its state allows, once its holds and guards pass and
      any signatures it needs are given. A locking state makes the database refuse every change to
      the record's tables until a state that doesn't lock is set.
    </p>
    <Diagram
      id="life"
      title="A record's life, from its type to its audit trail"
      width={910}
      height={380}
      boxes={life}
      edges={lifeEdges}
      caption="Solid arrows are the order things happen in; dashed ones are checks every save makes."
    >
      <div slot="manifest">
        <p>
          An <code>EntityType</code> under a plugin's <code>types/</code>: fields, an optional
          <code>identity</code>, state fields, rules and display. The core types every deployment
          has are in <Path p="spec/src/iki_spec/core/types" /> (<a href="/core-types/"
            >generated list</a
          >).
        </p>
        <p><Adr n={[32, 38]} /></p>
      </div>
      <div slot="tables">
        <p>
          The type's model extends <code>Entity</code> by multi-table inheritance. Beside it: a
          <code>__history</code> table keyed on (entity, revision), with wide column types and
          references kept as bare UUIDs; a table per list of references or files; named CHECK
          constraints for the field rules; and, for a type with an identity, <code>__entry</code>
          tables (<Adr n="0033" />).
        </p>
        <p>
          <Path p="codegen/src/iki_codegen/models.py" sym="def render_models(" />, <Path
            p="server/src/iki_server/entities/models.py"
            sym="class Entity("
          />
        </p>
      </div>
      <div slot="create">
        <p>
          <code>POST /api/v1/entities</code> needs edit access to the project. The service checks
          everything first (<code>prepare</code>), then writes in one transaction (<code
            >_create</code
          >). The full order is in <a href="#save">One save, in order</a>.
        </p>
        <p>
          <Path p="server/src/iki_server/api/entities.py" sym="def create_entity(" />, <Path
            p={S}
            sym="def create("
          />, <Path p={S} sym="def prepare(" />
        </p>
      </div>
      <div slot="revisions">
        <p>
          Each change writes a <code>Revision</code> (kind, changed fields, who, via what, the agent
          if any, a reason) and a full history row for each table it touched. <code
            >Entity.revision</code
          > is the current number and the API's ETag: an edit without <code>If-Match</code> gets
          428, a stale one 412 (<Adr n="0035" />).
        </p>
        <p>
          <Path p={S} sym="def _revise(" />, <Path p={S} sym="def _write_history(" />, <Path
            p={S}
            sym="def provenance("
          />
        </p>
      </div>
      <div slot="state">
        <p>
          <code>POST /api/v1/entities/{"{ref}"}/states/{"{field}"}</code>. Under the row lock: the
          field and state exist, the revision isn't stale, the state needs no signatures, the
          person's project and lab roles allow it (<code>set_by</code>), then open holds and the
          state's guards, then the reason (<Adr n={[125, 128]} />).
        </p>
        <p>
          <Path p={ST} sym="def set_state(" />, <Path p={ST} sym="def write(" />, <Path
            p="server/src/iki_server/entities/guards.py"
            sym="def refusals("
          />
        </p>
      </div>
      <div slot="entry">
        <p>
          A type with an <code>identity</code> is registered: the create finds the registry's entry
          for that identity under an advisory lock, or makes one, and the project's record points to
          it. A project that already has a record of it gets that record back, as <code>reused</code
          > (<Adr n="0115" />).
        </p>
        <p><Path p={S} sym="def _find_entry(" />, <a href="#registries">Registries and records</a></p>
      </div>
      <div slot="rules">
        <p>
          Plugins' <code>check</code> rules are CEL, run by iki-wasm on every save; on an edit only
          the rules reading a changed field run. <code>unique</code> and <code>no_overlap</code> are
          held by database triggers. A rule can hold a record for review instead of refusing it (<Adr
            n="0127"
          />).
        </p>
        <p>
          <Path p="server/src/iki_server/entities/checking.py" sym="def broken(" />, <Path
            p="server/src/iki_server/entities/holds.py"
            sym="def hold("
          />, <Path p="spec/src/iki_spec/rules.py" />
        </p>
      </div>
      <div slot="locked">
        <p>
          A state with <code>locks: true</code> puts its field in <code>Entity.locked_by</code>.
          A trigger on every table of a type with state fields refuses any insert, update or delete
          for a record whose <code>locked_by</code> isn't empty (<Adr n={[120, 125]} />).
        </p>
        <p>
          <Path p="server/src/iki_server/entities/migrations/0012_states.py" sym="iki_locked_guard" />, <Path
            p={ST}
            sym="def install_guards("
          />
        </p>
      </div>
      <div slot="signatures">
        <p>
          A state's <code>signatures</code> are slots, each with a meaning and a statement. Each
          signer signs in again at the identity provider; Iki signs a canonical document naming the
          SHA-256 of the record's content at that revision with the deployment's Ed25519 key. The
          last signature sets the state (<Adr n={[124, 126]} />).
        </p>
        <p>
          <Path p="server/src/iki_server/signatures/services.py" sym="def _sign(" />, <Path
            p="server/src/iki_server/signatures/reauth.py"
          />, <Path p="server/src/iki_server/signatures/proof.py" sym="def canonical(" />
        </p>
      </div>
      <div slot="correction">
        <p>
          Editing a locked record is refused unless every locking state it's in names an <code
            >on_edit</code
          > state. Then the edit, with a reason, first returns each to that state (full role and
          guard checks), then changes the values: two revisions in one transaction (<Adr n="0179" />).
        </p>
        <p>
          <Path p={ST} sym="def return_for_edit(" />, <Path p={S} sym="allow_correction" />
        </p>
      </div>
      <div slot="audit">
        <p>
          Events are written in the change's transaction and refused any update, delete or truncate
          by triggers and grants. A plain create or edit writes no audit event: its revision is its
          trail. State changes, holds, links and signatures do (<Adr n="0025" />).
        </p>
        <p><Path p="server/src/iki_server/audit/log.py" sym="ACTIONS" /></p>
      </div>
    </Diagram>

    <h3 id="save">One save, step by step</h3>
    <p>
      What <code>POST /api/v1/entities</code> does, step by step. All of it after the first phase is
      one database transaction; CHECK constraints and the lock and unique triggers fire as the rows
      are written.
    </p>
    <Sequence
      id="save-seq"
      title="Creating a record"
      width={900}
      actors={[
        { id: "client", label: "Client", sub: "app, SDK or agent" },
        { id: "api", label: "API", sub: "api/entities.py" },
        { id: "svc", label: "Services", sub: "entities/services.py" },
        { id: "wasm", label: "Rules", sub: "iki-wasm (CEL)" },
        { id: "db", label: "Postgres" },
      ]}
      steps={[
        { phase: "Checked first, outside the transaction" },
        { id: "post", from: "client", to: "api", label: "POST /api/v1/entities" },
        { id: "call", from: "api", to: "svc", label: "create()" },
        { id: "prepare", from: "svc", to: "svc", label: "prepare: type, each value, defaults, required" },
        { id: "cel", from: "svc", to: "wasm", label: "plugin rules on the new values" },
        { id: "broken", from: "wasm", to: "svc", label: "breaks: refuse, or hold with a reason", dashed: true },
        { phase: "One transaction" },
        { id: "entry", from: "svc", to: "db", label: "find or make the entry, under an advisory lock" },
        { id: "row", from: "svc", to: "db", label: "insert the typed row: HRID, identity hash" },
        { id: "revise", from: "svc", to: "db", label: "revision 1, then queue webhooks and triggers" },
        { id: "history", from: "svc", to: "db", label: "history rows, file uses, project link" },
        { id: "after", from: "svc", to: "db", label: "notifications; the hold, if it was held" },
        { id: "reply", from: "api", to: "client", label: "201, or 200 reused · ETag: the revision", dashed: true },
      ]}
    >
      <div slot="post">
        <p>Needs edit access to the target project. The MCP tool <code>create_entity</code> calls the same endpoint.</p>
        <p><Path p="server/src/iki_server/api/entities.py" sym="def create_entity(" />, <Path p="server/src/iki_server/mcp/tools.py" sym="create_entity" /></p>
      </div>
      <div slot="call">
        <p>Run results, imports, collections and setup data create records through the same service, so every path gets the same checks.</p>
        <p><Path p={S} sym="def create(" />, <Path p="server/src/iki_server/runs/results.py" /></p>
      </div>
      <div slot="prepare">
        <p>
          Refuses an abstract or frozen type; an unknown, removed, ledger, computed (unless a run
          writes it) or state field; converts and validates each value. New records start each state
          field at its <code>initial</code>. Then the core types' own rules in Python.
        </p>
        <p><Path p={S} sym="def prepare(" />, <Path p="server/src/iki_server/entities/rules.py" /></p>
      </div>
      <div slot="cel">
        <p>The record's values go to iki-wasm under wasmtime, with a fuel budget per call; the browser runs the same module (<Adr n="0127" />).</p>
        <p><Path p="server/src/iki_server/entities/checking.py" sym="def broken(" />, <Path p="spec/src/iki_spec/wasm.py" sym="FUEL" /></p>
      </div>
      <div slot="broken">
        <p>
          <code>raise_broken</code> refuses with every broken rule named, or, for rules that hold
          rather than refuse, needs a hold reason (422 <code>hold_reason_required</code> without
          one). <code>apart</code> names the record a unique or no-overlap rule clashes with.
        </p>
        <p><Path p="server/src/iki_server/entities/checking.py" sym="def raise_broken(" />, <Path p="server/src/iki_server/entities/checking.py" sym="def apart(" /></p>
      </div>
      <div slot="entry">
        <p>The lock key is the registry and the identity's digest, so two creates of the same thing can't both make an entry.</p>
        <p><Path p={S} sym="iki_entry:" />, <Path p="server/src/iki_server/entities/identity.py" sym="def hash_for(" /></p>
      </div>
      <div slot="row">
        <p><code>Entity.save</code> sets the type, takes the next HRID and, for an entry, the identity hash. Extension and list rows follow.</p>
        <p><Path p={S} sym="def _new_record(" /></p>
      </div>
      <div slot="revise">
        <p>
          <code>_revise</code> inserts the <code>Revision</code> and bumps <code>Entity.revision</code>;
          <code>_announce</code> then queues webhooks and records trigger firings in the same
          transaction, so they exist exactly when the change does (<Adr n={[31, 80]} />).
        </p>
        <p><Path p={S} sym="def _revise(" />, <Path p={S} sym="def _announce(" /></p>
      </div>
      <div slot="history">
        <p>A full row per touched table into its <code>__history</code>, the files the record uses, and its owner project's link.</p>
        <p><Path p={S} sym="def _write_history(" /></p>
      </div>
      <div slot="after">
        <p>Assignment notices and the type's declared notifications (<Adr n="0129" />); if a rule held it, the hold and its <code>entity.held</code> audit event.</p>
        <p><Path p="server/src/iki_server/notifications/declared.py" />, <Path p="server/src/iki_server/entities/holds.py" sym="def hold(" /></p>
      </div>
      <div slot="reply">
        <p>201 for a new record; 200 with <code>reused</code> when the project already had a record of that identity; <code>registered</code> says whether a new entry was made.</p>
        <p><Path p="server/src/iki_server/api/entities.py" sym="def create_entity(" /></p>
      </div>
    </Sequence>
    <p>
      <Inferred why="The code only queues rows in the transaction; the delivery workers weren't traced.">
        Webhook delivery and the runs triggers start happen after commit, from the task runner and
        the trigger machinery; this page shows only that they're queued in the transaction.
      </Inferred>
    </p>

    <h3 id="registries">Registries and project records</h3>
    <p>
      What a thing is and what a project knows about it are kept apart. The entry holds the
      identity, the facts about it, and the values the identity alone decides. Each project holds
      its own record of it, sharing the entry's HRID, with everything that depends on how that
      project made or measured it, accessions included (<Adr n={[115, 131, 154]} />).
    </p>
    <Diagram id="reg" title="An entry and its projects' records" width={780} height={240} boxes={reg} edges={regEdges}>
      <div slot="registry">
        <p>Every project is in one registry; registries and their registrars are org models.</p>
        <p><Path p="server/src/iki_server/org/models.py" sym="class Registry(" />, <Path p="server/src/iki_server/org/models.py" sym="class Registrar(" /></p>
      </div>
      <div slot="entryb">
        <p>
          An <code>iki_entity</code> row with a registry, no project, and an identity hash: canonical
          JSON of the identity fields, naming the type, hashed with SHA-256. Database constraints
          keep one entry per identity per registry, and one record per entry per project.
        </p>
        <p><Path p="spec/src/iki_spec/identity.py" sym="def identity_hash(" />, <Path p="server/src/iki_server/entities/models.py" sym="iki_entity_identity_once" /></p>
      </div>
      <div slot="reca">
        <p>A record has an owner project and an entry. A value is <code>registry: derived</code> only if the identity alone determines it; anything a run's parameters change is the record's (<Adr n="0131" />).</p>
        <p><Path p="server/src/iki_server/entities/models.py" sym="iki_entity_record_once" /></p>
      </div>
      <div slot="recb">
        <p>An accession (a UniProt ID, say) is the record's, not the entry's: two projects may have it from different sources (<Adr n="0154" />).</p>
      </div>
      <div slot="registrar">
        <p>A fact set once and <code>immutable</code> can only be superseded; other facts are set while empty, then changed only by a registrar (<Adr n="0143" />).</p>
        <p><Path p="server/src/iki_server/entities/entries.py" sym="def curate(" />, <Path p="server/src/iki_server/entities/entries.py" sym="def supersede(" /></p>
      </div>
    </Diagram>
  </Layer>

  <Layer n={3} title={H.example}>
    <p>
      <Path p="plugins/lots/types/plasmid_verification.yaml" label="iki/lots.PlasmidVerification" /> is a
      reviewer's assessment of one plasmid prep's sequencing evidence. It uses nearly everything on
      this page: computed, immutable pins; plugin rules; a state field with two review flows;
      guards that keep the signers independent; signatures; locks; and corrections.
    </p>
    <p>
      Its <code>review</code> state starts at <code>recorded</code>. Under the regulated QC flow, the
      analyst submits (signing <em>authorship</em>), an independent reviewer reviews (signing <em
        >review</em
      >), then QA releases (signing <em>approval</em>). Each of those states locks the record and
      names <code>on_edit: recorded</code>, so a correction sends it back to the start for review
      again. This is the released state, as the file says today:
    </p>
    <Excerpt
      file="plugins/lots/types/plasmid_verification.yaml"
      start="^      released:"
      note="the review field's last state"
    />
    <p>
      <code>independent_qa</code> is four-eyes written as a guard: the person releasing may not be
      the creator (<code>history.review[0].by</code>), the submitting analyst, the reviewer, or anyone
      who edited it while recorded. There's no four-eyes feature in core; the plugin says it in CEL
      (<Adr n="0128" />, which replaced <Adr n="0119" />'s <code>not_by</code>).
    </p>
    <p>And one of its save rules, which runs only when its <code>when</code> holds:</p>
    <Excerpt file="plugins/lots/types/plasmid_verification.yaml" start="^  explain_alignment_override:" />
    <p>
      The pins are why the record can be trusted later: <code>plasmid_revision</code> and <code
        >alignment_revision</code
      > are <code>computed</code> (only a run may write them) and <code>immutable</code> (refused once
      set), so a later edit to the plasmid can't change what this verification says it examined (<Adr
        n="0184"
      />).
    </p>
  </Layer>

  <Layer n={4} title={H.rules}>
    <div class="rules">
      <Rule title="What can never change" open>
        <p>
          <code>iki_revision</code> and every <code>__history</code> table are append-only twice
          over: a trigger (<code>iki_refuse_history_change()</code>) refuses UPDATE, DELETE and
          TRUNCATE, and the app role has no UPDATE or DELETE on them. Only a unit conversion inside a
          migration may rewrite history values, and it records that it did (<Adr n={[25, 33, 148]} />).
        </p>
        <p>
          Field by field: <code>immutable</code> and identity fields are refused once set; <code
            >computed</code
          > fields are refused unless a run writes them; a state field can't be set by an edit (<Path
            p={S}
            sym="def update("
          />).
        </p>
        <p>
          <Path p="server/src/iki_server/entities/migrations/0002_history_append_only.py" />, <Path
            p="server/src/iki_server/plugins/operations.py"
            sym="class AppendOnly"
          />
        </p>
      </Rule>
      <Rule title="Revisions: what each kind means">
        <p>The kinds, read from <Path p="server/src/iki_server/entities/models.py" sym="class RevisionKind" />:</p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Kind</th><th>Label</th><th>Note in the code</th></tr></thead>
            <tbody>
              {kinds.map((k) => <tr><td><code>{k.value}</code></td><td>{k.label}</td><td>{k.note}</td></tr>)}
            </tbody>
          </table>
        </div>
        <p>
          Reading a past revision takes each table's latest history row at or before that number.
          A field's provenance is the latest revision that changed it (<Adr n="0035" />).
        </p>
      </Rule>
      <Rule title="States: one field per question, and who sets each state">
        <p>
          A state is a field of <code>type: state</code> with an <code>initial</code> and its
          <code>states</code>; each state says who may set it (<code>set_by</code>, lab roles),
          whether it <code>locks</code>, needs a <code>reason</code>, needs <code>signatures</code>,
          what <code>on_edit</code> returns to, and its <code>guards</code>. There's no transition
          graph in core; allowed moves are guards on <code>state.from</code> (<Adr n="0125" />, which
          superseded <Adr n="0118" />'s transitions).
        </p>
        <p>
          Lab roles are declared by plugins and given per project (<Adr n="0116" />). A plugin can't
          strand records in a state it removes: it keeps it as <code>removed: true, moved_to</code>,
          and the migration moves them with a system revision (<Adr n="0121" />, <Path
            p="server/src/iki_server/plugins/operations.py"
            sym="class SyncStates"
          />).
        </p>
      </Rule>
      <Rule title="Locks are held by the database">
        <p>
          <code>sync_plugins</code> installs a <code>BEFORE INSERT OR UPDATE OR DELETE</code>
          trigger named <code>iki_locked__&lt;table&gt;</code> on every type and list table of a type
          with state fields. It raises <code>check_violation</code> when the record's <code
            >locked_by</code
          > isn't empty, unless the transaction set <code>iki.unlocked</code>, which only migrations
          do. Setting a state clears <code>locked_by</code> for its own write, under the row lock,
          then sets it again from the new state (<Adr n="0120" />).
        </p>
        <p>
          A result released to the project that requested it is final beyond that: once <code
            >released_review_revision</code
          > is set, its values and states can't change (<Adr n="0149" />, <Path
            p={ST}
            sym="def _final_release("
          />).
        </p>
      </Rule>
      <Rule title="Guards and holds">
        <p>
          Guards are CEL checks on entering a state, reading <code>actor</code>, <code>record</code>,
          <code>state</code>, <code>history</code>, <code>last</code>, <code>edits</code>, <code
            >holds</code
          >, <code>signatures</code>, <code>now</code> and <code>today</code>. They fail closed, run
          after <code>set_by</code> under the row lock, and run again at each signature (<Adr
            n="0128"
          />). An open hold blocks every locking state until someone reviews it (<Adr n="0127" />).
          Searches find what rules caught, as fields every entity has (<Adr n="0135" />).
        </p>
        <p>
          <Path p="server/src/iki_server/entities/guards.py" sym="def variables_of(" />, <Path
            p="server/src/iki_server/entities/holds.py"
            sym="def blocks_locking("
          />
        </p>
      </Rule>
      <Rule title="Signatures (21 CFR Part 11)">
        <p>
          Signing starts a short-lived <code>Signing</code>, sends the person to the identity
          provider with a forced fresh sign-in (OIDC <code>prompt=login</code>, <code>max_age=0</code
          >; SAML <code>ForceAuthn</code>), and on return checks the revision hasn't moved. Three
          failures in 15 minutes lock signing (<Adr n="0124" />).
        </p>
        <p>
          A signature counts while the record stays at the revision it signed; once the record
          changes, it has lapsed and the change needs it again (<Adr n="0126" />). Verification
          reads through renames and unit conversions that migrations recorded in <code
            >iki_history_change</code
          >, instead of calling them tampering (<Adr n="0148" />). Withdrawals, certifications and
          acknowledgments are append-only too.
        </p>
        <p>
          <Path p="server/src/iki_server/signatures/services.py" sym="def verify(" />, <Path
            p="server/src/iki_server/signatures/proof.py"
            sym="def read_through("
          />, <Path p="server/src/iki_server/signatures/models.py" sym="class Signature(" />
        </p>
      </Rule>
      <Rule title="Corrections">
        <p>
          There's no correction event model: a correction is a state return plus an edit. <code
            >PATCH /api/v1/entities/{"{ref}"}</code
          > passes <code>allow_correction=True</code>; runs and imports can't correct. The API tells
          the app whether a record can be corrected (<code>can.correct</code>), and guards can read
          what was edited in a state (<code>edits.&lt;field&gt;.&lt;state&gt;</code>) (<Adr
            n="0179"
          />).
        </p>
      </Rule>
      <Rule title="Archive, detach and purge">
        <p>
          Records are archived, not deleted: <code>set_archived</code> writes an <code>archived</code>
          or <code>restored</code> revision, and is refused for entries and locked records (<Adr
            n="0008"
          />, <Path p={S} sym="def set_archived(" />). A detached plugin's records are kept and
          frozen (<Adr n="0091" />). Purging a detached plugin's data, under legal holds, leaves a
          tombstone per record with its content's SHA-256 (<Adr n="0092" />, <Path
            p="server/src/iki_server/plugins/purge.py"
          />).
        </p>
      </Rule>
      <Rule title="Agents">
        <p>
          A change an agent makes names both the person and the agent: <code>Revision.agent</code>
          and <code>AuditEvent.agent</code> point to an append-only <code>Agent</code> row (client,
          grant, session, self-reported software and model) (<Adr n="0072" />). When a service account
          acts for a person, each lab role that authorizes a step must belong to both of them (<Adr
            n="0210"
          />).
        </p>
      </Rule>
    </div>
  </Layer>

  <Layer n={5} title={H.ref}>
