---
// One decision record, as docs/adr keeps it: its text, and beside it its status, date,
// the records it names, and the later ones that name it.
import { getCollection, render } from "astro:content";

import Doc from "../../layouts/Doc.astro";
import { laterDecisions } from "../../lib/adr.ts";
import { decisionList, decisionMap } from "../../lib/decisions.ts";
import { render as markdown } from "../../lib/markdown.ts";
import { decisionPath, github } from "../../lib/repo.ts";

export async function getStaticPaths() {
  const entries = (await getCollection("decisions")).filter((e) => e.data.kind === "decision");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
if (entry.data.kind !== "decision") {
  throw new Error(`${entry.id} isn't a decision`);
}
const d = entry.data;
const { Content } = await render(entry);
const all = await decisionList();
const decisions = await decisionMap();
const later = laterDecisions(d.number, all);
const index = all.findIndex((x) => x.number === d.number);
const previous = all[index - 1];
const next = all[index + 1];
const label = { accepted: "Accepted", proposed: "Proposed", superseded: "Superseded" } as const;
---

<Doc
  title={`ADR ${d.number}: ${d.title}`}
  description={`Decision ${d.number}: ${d.title}. ${label[d.standing]}, ${d.date}.`}
  section="Decisions"
>
  <p class="eyebrow">
    <a href="/decisions/">Decisions</a> / ADR {d.number}
  </p>
  <h1 class="doc-title adr-title">{d.title}</h1>
  <dl class="meta">
    <div>
      <dt>Status</dt>
      <dd>
        <span class:list={["standing", d.standing]}>{label[d.standing]}</span>{" "}
        <span
          class="detail"
          set:html={markdown(d.status.replace(/^\w+\s*/, ""), decisions, { inline: true })}
        />
      </dd>
    </div>
    <div>
      <dt>Date</dt>
      <dd>{d.date}</dd>
    </div>
    {d.fields.map((f) => (
      <div>
        <dt>{f.label}</dt>
        <dd set:html={markdown(f.markdown, decisions, { inline: true })} />
      </div>
    ))}
    {later.map((group) => (
      <div>
        <dt>{group.label}</dt>
        <dd>
          {group.decisions.map((other, i) => (
            <>
              {i > 0 && ", "}
              <a href={decisionPath(other.slug)}>ADR {other.number}</a>
            </>
          ))}
        </dd>
      </div>
    ))}
  </dl>
  <div class="prose adr">
    <Content />
  </div>
  <nav class="pager" aria-label="Other decisions">
    {previous ? <a href={decisionPath(previous.slug)}>← ADR {previous.number}</a> : <span />}
    <a class="out" href={github(`docs/adr/${d.slug}.md`)}>
      This record on GitHub<span class="sr-only"> (on GitHub)</span>
    </a>
    {next ? <a href={decisionPath(next.slug)}>ADR {next.number} →</a> : <span />}
  </nav>
</Doc>

<style>
  .adr-title {
    font-size: 36px;
  }
  .meta {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 6px 20px;
    margin: 20px 0 32px;
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--surface-2);
    font-size: 14px;
  }
  .meta div {
    display: contents;
  }
  .meta dt {
    color: var(--muted);
  }
  .meta dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: break-word;
  }
  .standing {
    font-size: 12px;
    font-weight: 600;
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--surface-3);
  }
  .standing.accepted {
    background: var(--bench-soft);
    color: var(--bench);
  }
  .standing.proposed {
    background: var(--run-soft);
    color: var(--run);
  }
  .adr {
    max-width: 760px;
  }
  .pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: 14px;
  }
  @media (max-width: 720px) {
    .adr-title {
      font-size: 28px;
    }
    .meta {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .meta dd {
      margin-bottom: 8px;
    }
  }
</style>
