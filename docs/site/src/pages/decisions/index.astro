---
// The decision records' index, generated from docs/adr: what an ADR is, then every
// record, newest first, which a reader can narrow by words or by status.
import { getCollection, getEntry, render } from "astro:content";

import Doc from "../../layouts/Doc.astro";
import { decisionPath } from "../../lib/repo.ts";

const all = (await getCollection("decisions"))
  .flatMap((entry) => (entry.data.kind === "decision" ? [entry.data] : []))
  .sort((a, b) => b.number.localeCompare(a.number));
const readme = await getEntry("decisions", "README");
if (!readme) {
  throw new Error("docs/adr/README.md wasn't loaded");
}
const { Content } = await render(readme);
const counts = {
  accepted: all.filter((d) => d.standing === "accepted").length,
  proposed: all.filter((d) => d.standing === "proposed").length,
  superseded: all.filter((d) => d.standing === "superseded").length,
};
const label = { accepted: "Accepted", proposed: "Proposed", superseded: "Superseded" } as const;
---

<Doc
  title="Decisions"
  description={`Iki's ${all.length} architecture decision records: why it's built the way it is, each with its context and consequences.`}
  section="Decisions"
  measure={900}
>
  <h1 class="doc-title">Decisions</h1>
  <div class="prose guide">
    <Content />
  </div>

  <section aria-labelledby="all-h" class="list" data-decisions>
    <div class="head">
      <h2 id="all-h">All {all.length} decisions</h2>
      <form class="filters needs-script" data-filter>
        <label class="field">
          <span>Find</span>
          <input type="search" name="q" autocomplete="off" placeholder="Title words or number" />
        </label>
        <label class="field">
          <span>Status</span>
          <select name="status">
            <option value="">Any ({all.length})</option>
            {(Object.keys(counts) as (keyof typeof counts)[]).map((s) => (
              <option value={s}>
                {label[s]} ({counts[s]})
              </option>
            ))}
          </select>
        </label>
      </form>
    </div>
    <p class="count needs-script" role="status" data-count></p>
    <ol class="rows">
      {all.map((d) => (
        <li data-standing={d.standing} data-text={`${d.number} ${d.title}`.toLowerCase()}>
          <span class="num mono">{d.number}</span>
          <a href={decisionPath(d.slug)}>{d.title}</a>
          <span class:list={["standing", d.standing]}>{label[d.standing]}</span>
          <span class="date">{d.date}</span>
        </li>
      ))}
    </ol>
  </section>
</Doc>

<script>
  import { startFilter } from "../../scripts/filter.ts";

  const list = document.querySelector<HTMLElement>("[data-decisions]");
  if (list) startFilter(list);
</script>

<style>
  .guide {
    margin-top: 16px;
    max-width: 720px;
  }
  .list {
    margin-top: 40px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: end;
    justify-content: space-between;
  }
  h2 {
    margin: 0;
    font-size: 24px;
    letter-spacing: -0.02em;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 12px;
    color: var(--muted);
  }
  .field input,
  .field select {
    min-height: 40px;
    padding: 0 10px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 14px;
  }
  .field input {
    width: min(280px, 100%);
  }
  .count {
    margin: 12px 0 0;
    font-size: 13px;
    color: var(--muted);
    min-height: 1.5em;
  }
  .rows {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .rows li {
    display: grid;
    grid-template-columns: 48px 1fr auto auto;
    gap: 4px 16px;
    align-items: baseline;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    font-size: 15px;
  }
  .rows li[hidden] {
    display: none;
  }
  .num {
    font-size: 13px;
    color: var(--muted);
  }
  .standing {
    font-size: 12px;
    font-weight: 600;
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--muted);
  }
  .standing.accepted {
    background: var(--bench-soft);
    color: var(--bench);
  }
  .standing.proposed {
    background: var(--run-soft);
    color: var(--run);
  }
  .date {
    font-size: 13px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 720px) {
    .rows li {
      grid-template-columns: 40px 1fr;
    }
    .standing,
    .date {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
