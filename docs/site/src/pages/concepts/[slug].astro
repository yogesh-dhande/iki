---
// A concept: how one part of Iki behaves, in increasing detail, with the use cases that
// show it and its reference.
import { getCollection, render } from "astro:content";

import ItemLink from "../../components/ItemLink.astro";
import Toc from "../../components/Toc.astro";
import Doc from "../../layouts/Doc.astro";
import { itemOf } from "../../lib/site.ts";

export async function getStaticPaths() {
  return (await getCollection("concepts")).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { data } = entry;
const sections = headings
  .filter((heading) => heading.depth === 2)
  .map((heading) => ({ id: heading.slug, label: heading.text }));
---

<Doc title={data.title} description={data.description} section="Concepts" audience={data.audience}>
  <nav class="breadcrumbs" aria-label="Breadcrumbs">
    <a href="/concepts/">Concepts</a> / {data.topic}
  </nav>
  <h1 class="doc-title">{data.title}</h1>
  <p class="lede">{data.description}</p>
  <div class="prose concept">
    <Content />
  </div>
  <aside slot="aside" class="side" aria-label="On this page">
    <Toc items={sections} />
    {data.useCases.length > 0 && (
      <div class="side-box">
        <h2>Use cases</h2>
        <ul>
          {data.useCases.map((link) => (
            <li>
              <ItemLink item={itemOf(link)} />
            </li>
          ))}
        </ul>
      </div>
    )}
  </aside>
</Doc>

<style>
  .lede {
    margin: 14px 0 0;
    max-width: 720px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--muted);
  }
  .concept {
    margin-top: 8px;
  }
  .concept > :global(h2) {
    margin-top: 48px;
    font-size: 26px;
  }
</style>
