---
import { getCollection, render } from "astro:content";

import ItemLink from "../../components/ItemLink.astro";
import Toc from "../../components/Toc.astro";
import Doc from "../../layouts/Doc.astro";
import { itemOf, SIDE_NAV } from "../../lib/site.ts";

export async function getStaticPaths() {
  return (await getCollection("concepts")).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const layers = [
  { id: "short", label: "In short" },
  { id: "how", label: "How it works" },
  { id: "example", label: "Worked example" },
  { id: "rules", label: "The rules in full" },
  { id: "ref", label: "Reference" },
];
---

<Doc
  title={data.title}
  description={data.description}
  section="Concepts"
  audience={data.audience}
  band={data.band}
>
  <nav slot="nav" class="section-nav" aria-label="Pages for this audience">
    {SIDE_NAV[data.audience].map((group) => (
      <>
        <h2>{group.section}</h2>
        <ul>
          {group.items.map((item) => (
            <li>
              <ItemLink item={item} />
            </li>
          ))}
        </ul>
      </>
    ))}
  </nav>
  <p class="eyebrow">
    <a href="/concepts/">Concepts</a> / {data.topic}
  </p>
  <h1 class="doc-title">{data.title}</h1>
  <Content />
  <aside slot="aside" class="side" aria-label="On this page">
    <Toc items={layers} />
    <div class="side-box audience">
      <h2>Guides</h2>
      <p>{data.guide.text}</p>
      <ItemLink item={itemOf(data.guide)} />
    </div>
  </aside>
</Doc>
