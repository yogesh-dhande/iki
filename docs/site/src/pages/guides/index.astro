---
// Every guide, by who it's for: the home page's three doors, in full.
import Listing from "../../components/listing/Listing.astro";
import Doc from "../../layouts/Doc.astro";
import { AUDIENCES, DOORS, type Audience } from "../../lib/site.ts";

const doors = (Object.keys(DOORS) as Audience[]).map((id) => ({
  ...AUDIENCES[id],
  items: DOORS[id],
}));
---

<Doc
  title="Guides"
  description="Iki's guides, by who they're for: at the bench, running Iki, and building on it."
  section="Guides"
>
  <h1 class="doc-title">Guides</h1>
  <p class="intro">
    How to do each task in Iki, for the people who do it: scientists and QA at the bench, the admins
    who run Iki, and the people who build plugins for it.
  </p>
  {doors.map((door) => (
    <section id={door.id} data-audience={door.id} aria-labelledby={`${door.id}-h`} class="door">
      <h2 id={`${door.id}-h`}>{door.label}</h2>
      <p class="who">{door.who}</p>
      <Listing items={door.items} />
    </section>
  ))}
</Doc>

<style>
  .intro {
    margin: 14px 0 0;
    max-width: 680px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
  }
  .door {
    margin-top: 40px;
  }
  h2 {
    margin: 0 0 4px;
    font-size: 22px;
    letter-spacing: -0.01em;
  }
  .who {
    margin: 0 0 12px;
    color: var(--muted);
  }
</style>
