---
// Every use case, one line each, in the navigation's order.
import Listing from "../../components/listing/Listing.astro";
import Doc from "../../layouts/Doc.astro";
import { sitePages } from "../../lib/pages.ts";
import { useCasesInOrder } from "../../lib/site.ts";

const items = useCasesInOrder(await sitePages()).map((page) => ({
  label: page.label,
  href: page.href,
  ...(page.text === undefined ? {} : { text: page.text }),
}));
---

<Doc
  title="Use cases"
  description="Lab workflows in Iki, each from its start to a signed result, its steps by the role that does them."
  section="Use cases"
>
  <h1 class="doc-title">Use cases</h1>
  <p class="intro">
    Lab workflows in Iki, each from its start to a signed result, its steps by the role that does
    them, on public or simulated data.
  </p>
  <Listing items={items} />
</Doc>

<style>
  .intro {
    margin: 14px 0 28px;
    max-width: 680px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
