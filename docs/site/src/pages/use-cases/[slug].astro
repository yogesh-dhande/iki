---
// A use case: one task done end to end, its steps by who does them, on real (or plainly
// synthetic) data, with what explains it and what it calls on the side.
import { getCollection, render } from "astro:content";

import ItemLink from "../../components/ItemLink.astro";
import Doc from "../../layouts/Doc.astro";
import { itemOf } from "../../lib/site.ts";

export async function getStaticPaths() {
  return (await getCollection("useCases")).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
---

<Doc
  title={data.title}
  description={data.description}
  section="Use cases"
  audience={data.audience}
  measure={900}
>
  <nav class="breadcrumbs" aria-label="Breadcrumbs">
    <a href="/use-cases/">Use cases</a> / {data.topic}
  </nav>
  <h1 class="doc-title">{data.title}</h1>
  <p class="lede">{data.description}</p>
  <dl class="facts">
    {data.facts.map((fact) => (
      <div>
        <dt>{fact.label}</dt>
        <dd class:list={{ mono: fact.code }}>{fact.value}</dd>
      </div>
    ))}
  </dl>
  <Content />
  <aside slot="aside" class="side" aria-label="Related">
    {data.concepts.length > 0 && (
      <div class="side-box">
        <h2>Concepts</h2>
        <ul>
          {data.concepts.map((link) => (
            <li>
              <ItemLink item={itemOf(link)} />
              {link.note && <span class="note"> {link.note}</span>}
            </li>
          ))}
        </ul>
      </div>
    )}
    <div class="side-box">
      <h2>Reference</h2>
      <ul class="mono-list">
        {data.reference.map((link) => (
          <li>
            <ItemLink item={itemOf(link)} class="mono" />
          </li>
        ))}
      </ul>
    </div>
    {data.aside && (
      <div class="side-box quiet">
        <h2>{data.aside.title}</h2>
        <p>{data.aside.text}</p>
        <ItemLink item={itemOf({ label: "The worked fit", href: data.aside.href })} />
      </div>
    )}
  </aside>
</Doc>

<style>
  .lede {
    margin: 14px 0 0;
    max-width: 720px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--muted);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr));
    gap: 16px 24px;
    margin: 24px 0 0;
    padding: 18px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    font-size: 14px;
  }
  .facts dt {
    font-size: 12px;
    color: var(--muted);
  }
  .facts dd {
    margin: 4px 0 0;
    font-weight: 500;
  }
  .facts dd.mono {
    font-size: 13px;
  }
  .mono-list :global(a) {
    font-size: 13px;
    overflow-wrap: anywhere;
  }
</style>
