---
// The home page: what Iki is, then its pages by audience, the lab workflows, the concepts
// and the reference, as plain lists of links.
import ItemLink from "../components/ItemLink.astro";
import Base from "../layouts/Base.astro";
import { doseResponse, puc19 } from "../lib/examples.ts";
import { github } from "../lib/repo.ts";
import { AUDIENCES, CONCEPTS, DOORS, PAGES, REFERENCES, type Audience } from "../lib/site.ts";

const reads = puc19.values;
const excluded = doseResponse.exclusion.well;

const workflows = [
  {
    title: "Dose-response assays",
    text: `A plate reader's export mapped to its wells, and an IC50 with its 95% interval, with ${excluded} excluded for a recorded reason, signed and returned to the project that asked for it.`,
    href: PAGES.doseResponse,
    out: false,
  },
  {
    title: "Plasmid prep verification",
    text: `A pUC19 prep's ${reads.reads_total} public MinION reads compared with ${puc19.data.accession}, and its ${reads.differences.length} differences named in HGVS for a reviewer to sign.`,
    href: `${PAGES.prepVerification}#example`,
    out: false,
  },
  {
    title: "Antibody engineering",
    text: "Trastuzumab's heavy and light chains numbered by ANARCI and assembled into an Fv, with its sequence liabilities and a predicted structure.",
    href: github("plugins/antibody/README.md"),
    out: true,
  },
  {
    title: "Compound registration",
    text: "Aspirin drawn another way registered as the same compound, and caffeine imported from PubChem.",
    href: github("plugins/small_molecule/README.md"),
    out: true,
  },
];
const doors = (Object.keys(DOORS) as Audience[]).map((id) => ({
  ...AUDIENCES[id],
  items: DOORS[id],
}));
---

<Base
  title="Iki documentation"
  description="Iki is open-source software for a lab's scientific records. Guides for scientists, admins and plugin authors."
>
  <main id="content" class="wrap home" data-pagefind-body>
    <h1>Iki documentation</h1>
    <p class="lede">
      Iki is open-source software for a lab's scientific records. It keeps each record's revisions
      and electronic signatures, and the run and inputs behind every computed value.
    </p>
    <p class="status">Iki is in early development and isn't ready for production use.</p>

    <div class="doors">
      {doors.map((door) => (
        <section data-audience={door.id} aria-labelledby={`door-${door.id}`}>
          <h2 id={`door-${door.id}`}>{door.label}</h2>
          <p class="who">{door.who}</p>
          <ul>
            {door.items.map((item) => (
              <li>
                <ItemLink item={item} />
              </li>
            ))}
          </ul>
          <p class="all">
            <a href={door.all}>All guides</a>
          </p>
        </section>
      ))}
    </div>

    <section aria-labelledby="workflows-h">
      <h2 id="workflows-h">Lab workflows</h2>
      <ul class="workflows">
        {workflows.map((w) => (
          <li>
            <a href={w.href} class:list={{ out: w.out }}>
              {w.title}
              {w.out && <span class="sr-only"> (on GitHub)</span>}
            </a>
            <p>{w.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <div class="pair">
      <section aria-labelledby="concepts-h">
        <h2 id="concepts-h">Concepts</h2>
        <ul>
          {CONCEPTS.map((item) => (
            <li>
              <ItemLink item={item} />
            </li>
          ))}
        </ul>
      </section>
      <section aria-labelledby="reference-h">
        <h2 id="reference-h">Reference</h2>
        <ul>
          {REFERENCES.map((item) => (
            <li>
              <ItemLink item={item} />
              {item.note && <span class="note"> {item.note}</span>}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </main>
</Base>

<style>
  .home {
    padding-top: 56px;
    padding-bottom: 80px;
  }
  h1 {
    margin: 0;
    font-size: 40px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .lede {
    margin: 16px 0 0;
    max-width: 680px;
    font-size: 18px;
    line-height: 1.55;
  }
  .status {
    margin: 12px 0 0;
    font-size: 15px;
    color: var(--muted);
  }
  h2 {
    margin: 0 0 8px;
    font-size: 22px;
    letter-spacing: -0.01em;
  }
  section {
    margin-top: 48px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    padding: 6px 0;
  }
  .doors {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 0 40px;
  }
  .who {
    margin: 0 0 8px;
    color: var(--muted);
  }
  .all {
    margin: 8px 0 0;
    font-size: 15px;
  }
  .workflows {
    max-width: 780px;
  }
  .workflows li {
    padding: 10px 0;
  }
  .workflows p {
    margin: 4px 0 0;
    color: var(--muted);
  }
  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 0 40px;
  }
  .note {
    color: var(--muted);
    font-size: 15px;
  }
  @media (max-width: 720px) {
    .home {
      padding-top: 36px;
    }
    h1 {
      font-size: 32px;
    }
  }
</style>
