---
// The home page: what Iki is, then each audience's pages, the concepts and the reference,
// as plain lists of links.
import ItemLink from "../components/ItemLink.astro";
import Base from "../layouts/Base.astro";
import { inSection, sitePages } from "../lib/pages.ts";
import { AUDIENCES, REFERENCES, REPOSITORY_GUIDES, type Audience, type Item } from "../lib/site.ts";

const pages = await sitePages();
const listed = (id: Audience): Item[] => {
  const audience = AUDIENCES[id];
  const own = inSection(pages, audience.section).filter((page) => page.audience === id);
  return [...own, ...(id === "bench" ? [] : REPOSITORY_GUIDES[id])];
};
const doors = (Object.keys(AUDIENCES) as Audience[]).map((id) => ({
  ...AUDIENCES[id],
  items: listed(id),
}));
const concepts = inSection(pages, "Concepts");
---

<Base
  title="Iki documentation"
  description="Iki is open-source software for a lab's scientific records. Use cases for scientists and QA, guides for admins and plugin authors."
>
  <main id="content" class="wrap home" data-pagefind-body>
    <h1>Iki documentation</h1>
    <p class="lede">
      Iki is open-source software for a lab's scientific records. It keeps each record's revisions
      and electronic signatures, and the run and inputs behind every computed value.
    </p>
    <p class="status">Iki is in early development and isn't ready for production use.</p>

    <div class="doors">
      {doors.map((door) => (
        <section data-audience={door.id} aria-labelledby={`door-${door.id}`}>
          <h2 id={`door-${door.id}`}>{door.label}</h2>
          <p class="who">{door.who}</p>
          <ul>
            {door.items.map((item) => (
              <li>
                <ItemLink item={item} />
              </li>
            ))}
          </ul>
          <p class="all">
            <a href={door.all}>All {door.section.toLowerCase()}</a>
          </p>
        </section>
      ))}
    </div>

    <div class="pair">
      <section aria-labelledby="concepts-h">
        <h2 id="concepts-h">Concepts</h2>
        <ul>
          {concepts.map((item) => (
            <li>
              <ItemLink item={item} />
            </li>
          ))}
        </ul>
      </section>
      <section aria-labelledby="reference-h">
        <h2 id="reference-h">Reference</h2>
        <ul>
          {REFERENCES.map((item) => (
            <li>
              <ItemLink item={item} />
              {item.note && <span class="note"> {item.note}</span>}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </main>
</Base>

<style>
  .home {
    padding-top: 56px;
    padding-bottom: 80px;
  }
  h1 {
    margin: 0;
    font-size: 40px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .lede {
    margin: 16px 0 0;
    max-width: 680px;
    font-size: 18px;
    line-height: 1.55;
  }
  .status {
    margin: 12px 0 0;
    font-size: 15px;
    color: var(--muted);
  }
  h2 {
    margin: 0 0 8px;
    font-size: 22px;
    letter-spacing: -0.01em;
  }
  section {
    margin-top: 48px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    padding: 6px 0;
  }
  .doors {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 0 40px;
  }
  .who {
    margin: 0 0 8px;
    color: var(--muted);
  }
  .all {
    margin: 8px 0 0;
    font-size: 15px;
  }
  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 0 40px;
  }
  .note {
    color: var(--muted);
    font-size: 15px;
  }
  @media (max-width: 720px) {
    .home {
      padding-top: 36px;
    }
    h1 {
      font-size: 32px;
    }
  }
</style>
