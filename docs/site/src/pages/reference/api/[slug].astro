---
// One REST call: what it does, its parameters, body and response, an example, and where
// the rest of the site uses it. All of it from the OpenAPI document, the SDK's and MCP
// server's code, and the site's own pages.
import { getCollection } from "astro:content";

import ApiNav from "../../../components/api/ApiNav.astro";
import Fields from "../../../components/api/Fields.astro";
import MethodBadge from "../../../components/api/MethodBadge.astro";
import TypeText from "../../../components/api/TypeText.astro";
import Doc from "../../../layouts/Doc.astro";
import { api, endpointPath, shortPath } from "../../../lib/api.ts";
import { sameCall } from "../../../lib/calls.ts";
import { render } from "../../../lib/markdown.ts";
import { curl, exampleOf, tagSlug, type Endpoint } from "../../../lib/openapi.ts";
import { github } from "../../../lib/repo.ts";

export function getStaticPaths() {
  return api().all.map((endpoint) => ({ params: { slug: endpoint.slug }, props: { endpoint } }));
}

interface Props {
  endpoint: Endpoint;
}
const { endpoint: e } = Astro.props;
const { doc } = api();
const here = endpointPath(e.slug);

// The site's pages that link here, by the section they're in.
const linking = (
  entries: { id: string; body?: string | undefined; data: object }[],
  base: string,
) =>
  entries
    .filter((entry) => `${entry.body ?? ""}${JSON.stringify(entry.data)}`.includes(here))
    .map((entry) => ({
      title: (entry.data as { title: string }).title,
      href: `${base}${entry.id}/`,
    }));
const related = [
  { section: "Use cases", pages: linking(await getCollection("useCases"), "/use-cases/") },
  { section: "Concepts", pages: linking(await getCollection("concepts"), "/concepts/") },
].filter((group) => group.pages.length > 0);

const elsewhere = sameCall(e.method, e.path);
const ok = e.responses.find((r) => r.status.startsWith("2"));
const okSchema = ok?.schema ? doc.components.schemas[ok.schema] : undefined;
const example = ok?.schema
  ? JSON.stringify(exampleOf({ $ref: `#/components/schemas/${ok.schema}` }, doc), null, 2)
  : null;
const bodyExample = e.body
  ? JSON.stringify(
      exampleOf(e.body.schema ? { $ref: `#/components/schemas/${e.body.schema}` } : {}, doc),
      null,
      2,
    )
  : null;
const path = e.parameters.filter((p) => p.in === "path");
const query = e.parameters.filter((p) => p.in !== "path");
---

<Doc
  title={`${e.method.toUpperCase()} ${shortPath(e.path)}`}
  description={`${e.summary}: the ${e.method.toUpperCase()} ${e.path} call of Iki's REST API.`}
  section="Reference"
  audience="build"
  measure={900}
>
  <ApiNav slot="nav" current={e.tag} />
  <nav class="breadcrumbs" aria-label="Breadcrumbs">
    <a href="/reference/">Reference</a> / <a href="/reference/api/">REST API</a> /{" "}
    <a href={`/reference/api/#${tagSlug(e.tag)}`}>
      {e.tag.charAt(0).toUpperCase() + e.tag.slice(1)}
    </a>
  </nav>
  <h1 class="title">{e.summary}</h1>
  <p class="call">
    <MethodBadge method={e.method} />
    <code class="path">{e.path}</code>
  </p>
  {e.description && <div class="prose" set:html={render(e.description)} />}
  <p class="about">
    {e.security.length > 0 && <>Authentication: {e.security.join(" or ")}. </>}
    Operation ID: <code>{e.operationId}</code>.
  </p>

  {path.length + query.length > 0 && (
    <section aria-labelledby="parameters-h" class="part">
      <h2 id="parameters-h">Parameters</h2>
      <Fields fields={[...path, ...query]} caption="Parameters" where />
    </section>
  )}

  {e.body && (
    <section aria-labelledby="body-h" class="part">
      <h2 id="body-h">Request body</h2>
      <p class="kind">
        <TypeText type={e.body.type} />
        {e.body.required ? " · required" : " · optional"}
      </p>
      {e.body.fields.length > 0 && <Fields fields={e.body.fields} caption="Request body" />}
    </section>
  )}

  <section aria-labelledby="response-h" class="part">
    <h2 id="response-h">Response</h2>
    {e.responses.map((r) => (
      <>
        <p class="kind">
          <span class="status">{r.status}</span> {r.description}
          {r.type && (
            <>
              {" · "}
              <TypeText type={r.type} />
            </>
          )}
        </p>
        {r.schema === ok?.schema && okSchema?.description && (
          <div class="prose" set:html={render(okSchema.description)} />
        )}
        {r.fields.length > 0 && <Fields fields={r.fields} caption={`Response ${r.status}`} />}
      </>
    ))}
    <p class="note">Errors are RFC 9457 problem details, as on every call.</p>
  </section>

  <section aria-labelledby="example-h" class="part" data-pagefind-ignore="all">
    <h2 id="example-h">Example</h2>
    <p class="note">
      With <code>IKI_URL</code> the deployment's address and <code>IKI_TOKEN</code> a token. The
      values are from one lab's QC dose-response result, <code>QSF-000014</code>.
    </p>
    <pre tabindex="0" role="region" aria-label="Request"><code>{curl(e)}</code></pre>
    {bodyExample && (
      <>
        <p class="note">
          <code>body.json</code>:
        </p>
        <pre tabindex="0" role="region" aria-label="Request body"><code>{bodyExample}</code></pre>
      </>
    )}
    {example && (
      <>
        <p class="note">The response:</p>
        <pre tabindex="0" role="region" aria-label="Response"><code>{example}</code></pre>
      </>
    )}
  </section>

  <aside slot="aside" class="side" aria-label="Related">
    {related.map((group) => (
      <div class="side-box">
        <h2>{group.section}</h2>
        <ul>
          {group.pages.map((page) => (
            <li>
              <a href={page.href}>{page.title}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <div class="side-box quiet">
      <h2>Same call elsewhere</h2>
      {elsewhere.sdk.length + elsewhere.mcp.length > 0 ? (
        <ul>
          {elsewhere.sdk.map((name) => (
            <li>
              Python SDK{" "}
              <a class="mono out" href={github("sdk/python/src/iki/client.py")}>
                {name}
              </a>
            </li>
          ))}
          {elsewhere.mcp.map((name) => (
            <li>
              MCP tool{" "}
              <a class="mono out" href={github("server/src/iki_server/mcp/tools.py")}>
                {name}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p>Neither the Python SDK nor the MCP server makes this call; use it directly.</p>
      )}
    </div>
  </aside>
</Doc>

<style>
  .title {
    margin: 0;
    font-size: 36px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .call {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin: 18px 0;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--code-bg);
  }
  .path {
    font-size: 15px;
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .part {
    margin-top: 36px;
  }
  .part h2 {
    margin: 0 0 12px;
    font-size: 22px;
    letter-spacing: -0.01em;
  }
  .kind {
    margin: 0 0 12px;
    font-size: 14px;
  }
  .status {
    font-family: var(--mono);
    font-weight: 700;
    color: var(--bench);
  }
  .note {
    margin: 12px 0 8px;
    font-size: 14px;
    color: var(--muted);
  }
  .side-box .note {
    margin: 0;
  }
  pre {
    max-height: 520px;
  }
  .about {
    margin: 12px 0 0;
    font-size: 15px;
    color: var(--muted);
  }
</style>
