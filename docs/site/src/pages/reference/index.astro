---
// Reference: what's generated from the source, and what's still in the repository.
import ItemLink from "../../components/ItemLink.astro";
import Doc from "../../layouts/Doc.astro";
import { api } from "../../lib/api.ts";
import { decisionList } from "../../lib/decisions.ts";
import { REFERENCES } from "../../lib/site.ts";

const { all, doc } = api();
const decisions = await decisionList();
---

<Doc
  title="Reference"
  description="Iki's REST API, plugin spec, CLI, SDK and decisions, generated from the source."
  section="Reference"
  audience="build"
  band="For plugin authors, integrators and coding agents."
>
  <h1 class="doc-title">Reference</h1>
  <p class="lede-text">
    Generated from the source on every build, so it says what the code does. Until a reference is
    generated here, it links to the document in the repository that covers it.
  </p>
  <ul class="refs">
    <li>
      <a href="/reference/api/">REST API</a>
      <span>
        {all.length} calls and {Object.keys(doc.components.schemas).length} schemas, from the
        server's OpenAPI document
      </span>
    </li>
    {REFERENCES.filter((item) => item.href !== "/reference/api/").map((item) => (
      <li>
        <ItemLink item={item} />
        {item.note && <span>{item.note}</span>}
      </li>
    ))}
    <li>
      <a href="/decisions/">Decisions (ADRs)</a>
      <span>{decisions.length} records of why Iki is built as it is</span>
    </li>
  </ul>
</Doc>

<style>
  .lede-text {
    margin: 14px 0 28px;
    max-width: 680px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
  }
  .refs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .refs li {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    font-size: 16px;
  }
  .refs li > :first-child {
    font-weight: 600;
    min-width: 200px;
  }
  .refs span:not(.sr-only) {
    font-size: 14px;
    color: var(--muted);
  }
</style>
