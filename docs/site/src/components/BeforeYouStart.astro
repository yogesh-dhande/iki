---
// A use case's prerequisites, from its frontmatter, the same on every use case: the plugins
// and their versions, a starter, the roles, where its actions run, its data and the outside
// services it calls. A use case puts it right after its "In short".
import { pluginHref, plugins } from "../lib/plugins.ts";
import { COMPUTE, prerequisites as schema } from "../lib/prerequisites.ts";

interface Props {
  /** The page's `frontmatter.prerequisites`, checked as the collection checks it. */
  prerequisites: unknown;
}
const given = schema.parse(Astro.props.prerequisites);
const known = plugins();
const href = (name: string) => {
  const plugin = known.find((candidate) => candidate.name === name);
  return plugin ? pluginHref(plugin) : undefined;
};
---

<section class="before" aria-labelledby="before-you-start">
  <h2 id="before-you-start">Before you start</h2>
  <dl>
    <dt>Plugins</dt>
    <dd>
      <ul>
        {given.plugins.map((plugin) => (
          <li>
            <a href={href(plugin.name)}>
              <code>{plugin.name}</code>
            </a>{" "}
            <code>{plugin.version}</code>
          </li>
        ))}
      </ul>
    </dd>
    {given.starter && (
      <>
        <dt>Starter</dt>
        <dd>
          <code>{given.starter}</code>
        </dd>
      </>
    )}
    <dt>Roles</dt>
    <dd>
      <ul>
        {given.roles.map((role) => (
          <li>
            <strong>{role.role}</strong>: {role.needs}
          </li>
        ))}
      </ul>
    </dd>
    <dt>Compute</dt>
    <dd>{COMPUTE[given.compute]}</dd>
    <dt>Data</dt>
    <dd>
      {given.data.length === 0 ? (
        "None"
      ) : (
        <ul>
          {given.data.map((item) => (
            <li>
              {item.name}
              <span class="detail">
                Source: {item.source}. Licence: {item.licence}.
              </span>
            </li>
          ))}
        </ul>
      )}
    </dd>
    <dt>Outside services</dt>
    <dd>
      {given.services.length === 0 ? (
        "None"
      ) : (
        <ul>
          {given.services.map((service) => (
            <li>
              <strong>{service.name}</strong>: {service.use}
            </li>
          ))}
        </ul>
      )}
    </dd>
  </dl>
</section>

<style>
  .before {
    margin: 28px 0 8px;
  }
  dl {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    gap: 10px 20px;
    margin: 12px 0 0;
    padding: 14px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    font-size: 15px;
  }
  dt {
    font-weight: 600;
    color: var(--muted);
  }
  dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .detail {
    display: block;
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 480px) {
    dl {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
    dd + dt {
      margin-top: 8px;
    }
  }
</style>
