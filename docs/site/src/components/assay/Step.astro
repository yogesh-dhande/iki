---
// One step of a use case: its number, what it does, and whose step it is.
interface Props {
  n: number;
  id: string;
  title: string;
  role: string;
}
const { n, id, title, role } = Astro.props;
---

<section class="step" id={id} aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`}>{`${String(n)}. ${title}`}</h2>
  <p class="role">Done by: {role}</p>
  <div class="prose">
    <slot />
  </div>
</section>

<style>
  .step {
    margin-top: 44px;
  }
  h2 {
    margin: 0;
    font-size: 24px;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .role {
    margin: 4px 0 14px;
    color: var(--muted);
  }
</style>
