---
// One of a concept page's layers, read top to bottom in increasing detail: In short, How
// it works, Worked example, The rules in full, Reference.
interface Props {
  n: number;
  id: string;
  title: string;
}
const { n, id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-h`} class:list={["layer", { short: n === 1 }]}>
  <h2 id={`${id}-h`}>{title}</h2>
  <slot />
</section>

<style>
  .layer {
    margin-top: 48px;
  }
  .layer.short {
    margin-top: 28px;
  }
  h2 {
    margin: 0 0 12px;
    font-size: 26px;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .short h2 {
    font-size: 20px;
    letter-spacing: 0;
  }
  .short :global(.lead) {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
  }
  .short :global(ul) {
    margin: 16px 0 0;
    padding-left: 20px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .layer.short {
      margin-top: 28px;
    }
  }
</style>
