---
// A chain of records, each made by whoever owns that step, as a list read left to right
// (top to bottom on a phone). The step that's computed is marked out.
interface Step {
  owner: string;
  name: string;
  id?: string;
  note?: string;
  computed?: boolean;
}
interface Props {
  label: string;
  steps: Step[];
}
const { label, steps } = Astro.props;
---

<ol class="flow" aria-label={label}>
  {steps.map((step) => (
    <li class:list={["step", { computed: step.computed }]}>
      <span class="owner">{step.owner}</span>
      <span class="name">{step.name}</span>
      {step.id && <span class="id mono">{step.id}</span>}
      {step.note && <span class="note">{step.note}</span>}
    </li>
  ))}
</ol>

<style>
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 8px 28px;
  }
  .step {
    position: relative;
    flex: 1 1 130px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--surface);
  }
  .step + .step::before {
    content: "";
    position: absolute;
    left: -21px;
    top: 50%;
    width: 9px;
    height: 9px;
    border-top: 2px solid var(--muted);
    border-right: 2px solid var(--muted);
    transform: translateY(-50%) rotate(45deg);
  }
  .computed {
    flex-basis: 150px;
    border: 2px solid var(--accent);
    background: var(--accent-soft);
  }
  .owner {
    font-size: 13px;
    color: var(--muted);
  }
  .computed .owner {
    color: var(--accent-ink);
  }
  .name {
    font-weight: 600;
    font-size: 15px;
  }
  .id {
    font-size: 12px;
  }
  .note {
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .flow {
      flex-direction: column;
      gap: 24px;
    }
    .step {
      flex-basis: auto;
    }
    .step + .step::before {
      left: 50%;
      top: -17px;
      transform: translateX(-50%) rotate(135deg);
    }
  }
</style>
