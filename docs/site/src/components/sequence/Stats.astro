---
interface Props {
  label: string;
  items: { label: string; value: string }[];
}
const { label, items } = Astro.props;
---

<dl class="stats" aria-label={label}>
  {items.map((item) => (
    <div>
      <dt>{item.label}</dt>
      <dd>{item.value}</dd>
    </div>
  ))}
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(120px, 100%), 1fr));
    gap: 8px 24px;
    margin: 16px 0 24px;
    padding: 12px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  dt {
    font-size: 14px;
    color: var(--muted);
  }
  dd {
    margin: 2px 0 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
</style>
