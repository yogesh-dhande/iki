---
// The plugin spec reference's map: each group, and its kinds.
import { GROUPS, SPEC, spec } from "../../lib/spec.ts";

const here = Astro.url.pathname;
const pages = spec();
---

<nav class="section-nav" aria-label="Plugin spec">
  <h2>Plugin spec</h2>
  <ul>
    <li>
      <a href={SPEC} aria-current={here === SPEC ? "page" : undefined}>
        Overview
      </a>
    </li>
  </ul>
  {GROUPS.map((group) => (
    <>
      <h2>{group.title}</h2>
      <ul>
        {pages
          .filter((page) => page.group === group.id)
          .map((page) => (
            <li>
              <a href={page.href} aria-current={here === page.href ? "page" : undefined}>
                {page.title}
              </a>
            </li>
          ))}
      </ul>
    </>
  ))}
</nav>
