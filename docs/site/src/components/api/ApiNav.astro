---
// The API reference's map: each tag, and the calls of the one being read.
import { apiTags, endpointPath, shortPath } from "../../lib/api.ts";
import MethodBadge from "./MethodBadge.astro";

interface Props {
  /** The tag whose calls are listed. */
  current?: string | undefined;
}
const { current } = Astro.props;
const here = Astro.url.pathname;
---

<nav class="section-nav api-nav" aria-label="REST API">
  <h2>REST API</h2>
  <ul>
    <li>
      <a href="/reference/api/" aria-current={here === "/reference/api/" ? "page" : undefined}>
        Overview
      </a>
    </li>
  </ul>
  <h2>By area</h2>
  <ul>
    {apiTags().map((tag) =>
      tag.name === current ? (
        <li class="open">
          <a href={`/reference/api/#${tag.slug}`}>{tag.label}</a>
          <ul>
            {tag.endpoints.map((e) => (
              <li>
                <a
                  href={endpointPath(e.slug)}
                  aria-current={here === endpointPath(e.slug) ? "page" : undefined}
                  class="op"
                >
                  <MethodBadge method={e.method} small />
                  <span class="mono">{shortPath(e.path)}</span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ) : (
        <li>
          <a href={`/reference/api/#${tag.slug}`}>{tag.label}</a>
        </li>
      ),
    )}
  </ul>
</nav>

<style>
  .api-nav ul ul {
    margin: 2px 0 6px 6px;
    padding-left: 6px;
    border-left: 1px solid var(--border);
  }
  .api-nav .open > a {
    font-weight: 600;
  }
  .op {
    display: flex !important;
    gap: 6px;
    align-items: baseline;
    font-size: 12px;
  }
  .op .mono {
    overflow-wrap: anywhere;
    min-width: 0;
  }
</style>
