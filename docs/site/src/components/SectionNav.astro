---
// A page's left-hand navigation: its audience's guides and use cases, and every concept,
// under the top navigation's section names.
import ItemLink from "./ItemLink.astro";
import { sitePages } from "../lib/pages.ts";
import { sideNav, type Audience } from "../lib/site.ts";

interface Props {
  audience: Audience;
}
const groups = sideNav(await sitePages(), Astro.props.audience);
const here = Astro.url.pathname;
/** A guide's other pages show while one of its pages is open. */
const open = (href: string | undefined) => href !== undefined && here.startsWith(href);
---

<nav class="section-nav" aria-label="Pages for this audience">
  {groups.map((group) => (
    <>
      <h2>{group.section}</h2>
      <ul>
        {group.items.map((item) => (
          <li>
            <ItemLink item={item} />
            {item.children && open(item.href) && (
              <ul class="pages">
                {item.children.map((child) => (
                  <li>
                    <ItemLink item={child} />
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </>
  ))}
</nav>

<style>
  .pages {
    margin: 2px 0 6px 10px;
    padding-left: 6px;
    border-left: 1px solid var(--border);
  }
</style>
