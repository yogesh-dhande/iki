* text=auto eol=lf

# Lockfiles are generated. GitHub collapses them in PR diffs, but they stay
# diffable so dependency changes can still be reviewed.
uv.lock          linguist-generated=true
pnpm-lock.yaml   linguist-generated=true
Cargo.lock       linguist-generated=true

# The UCUM table and its licence ship byte for byte as published.
spec/src/iki_spec/units/ucum-essence.xml -text
spec/src/iki_spec/units/UCUM-LICENSE.md -text

# The explainer videos' renders: large, binary, and rebuilt from their sources by
# `make video`, so they live in Git LFS. CI never reads them (checkout skips LFS).
media/videos/out/*.mp4 filter=lfs diff=lfs merge=lfs -text
