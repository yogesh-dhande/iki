* text=auto eol=lf

# Lockfiles are generated. GitHub collapses them in PR diffs, but they stay
# diffable so dependency changes can still be reviewed.
uv.lock          linguist-generated=true
pnpm-lock.yaml   linguist-generated=true
Cargo.lock       linguist-generated=true

# The UCUM table and its licence ship byte for byte as published.
spec/src/iki_spec/units/ucum-essence.xml -text
spec/src/iki_spec/units/UCUM-LICENSE.md -text

# A CSV file as Excel writes it, CRLF line ends and all: its records' digests are of them.
plugins/oligo/tests/data/excel.csv -text

# QuantStudio exports as the software wrote them, one with Windows line ends: records hold their digests.
examples/plugins/instrument_intake/tests/data/*.txt -text

# SnapGene files are binary, and the tests' digests are of their bytes as SnapGene wrote them.
*.dna binary

# Inter (ADR 0176), as @fontsource-variable/inter publishes it; web/app's fonts.test.ts checks.
*.woff2 binary
server/src/iki_server/web/static/iki/fonts/inter-LICENSE.txt -text

# Engine notices are vendored verbatim, including upstream whitespace.
web/packages/science/licenses/*.txt -text -whitespace
