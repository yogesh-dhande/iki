{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ikisci.org/schemas/bundle/v1",
  "title": "Iki bundle (iki/v1)",
  "description": "A bundle's `bundle.json`: entities from one project of one deployment, with their history, for another deployment to import (ADR 0096). It lists the SHA-256 of every other member of the archive, and `bundle.json.sig` is the source deployment's Ed25519 signature of its bytes. The `$defs` are the lines of its NDJSON members.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "id",
    "created_at",
    "source",
    "exported_by",
    "reason",
    "project",
    "selection",
    "plugins",
    "counts",
    "members"
  ],
  "properties": {
    "apiVersion": {
      "const": "iki/v1"
    },
    "kind": {
      "const": "Bundle"
    },
    "id": {
      "description": "The bundle's own ID.",
      "$ref": "#/$defs/uuid"
    },
    "created_at": {
      "$ref": "#/$defs/time"
    },
    "source": {
      "description": "The deployment it came from.",
      "type": "object",
      "required": ["deployment", "url", "iki", "key"],
      "properties": {
        "deployment": {
          "description": "Its name, such as `staging` (`IKI_ENVIRONMENT`). The importing deployment trusts keys by this name.",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "url": {
          "description": "Its address, or empty if it has none configured.",
          "type": "string",
          "maxLength": 2000
        },
        "iki": {
          "description": "Its Iki release, such as `0.1.0`.",
          "type": "string",
          "maxLength": 100
        },
        "key": {
          "description": "The public key that signed it, as `ed25519:` and the key's 32 bytes in unpadded base64url.",
          "$ref": "#/$defs/publicKey"
        }
      },
      "additionalProperties": false
    },
    "exported_by": {
      "description": "Who exported it.",
      "$ref": "#/$defs/person"
    },
    "reason": {
      "description": "Why, as they said.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "project": {
      "description": "The project its entities belong to.",
      "type": "object",
      "required": ["id", "team", "name", "slug"],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "team": {
          "type": "string",
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "slug": {
          "type": "string",
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "selection": {
      "description": "What was picked, in words, such as `COL-000004 (Validated primers) and what its members refer to`.",
      "type": "string",
      "maxLength": 2000
    },
    "plugins": {
      "description": "The plugins of the bundle's types, as installed when it was made.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/plugin"
      }
    },
    "counts": {
      "type": "object",
      "required": ["entities", "revisions", "files", "outside"],
      "properties": {
        "entities": {
          "$ref": "#/$defs/count"
        },
        "entries": {
          "description": "The registry entries its records are of (ADR 0115).",
          "$ref": "#/$defs/count"
        },
        "revisions": {
          "$ref": "#/$defs/count"
        },
        "files": {
          "$ref": "#/$defs/count"
        },
        "outside": {
          "$ref": "#/$defs/count"
        },
        "runs": {
          "$ref": "#/$defs/count"
        }
      },
      "additionalProperties": false
    },
    "members": {
      "description": "Every other member of the archive, each once. A reader refuses an archive with a member that isn't here, or whose bytes don't match.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/member"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "time": {
      "description": "An ISO 8601 date and time, with its offset.",
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "publicKey": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]{43}$"
    },
    "member": {
      "type": "object",
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {
          "description": "`people.ndjson`, `agents.ndjson`, `files.ndjson`, `entries.ndjson`, `entities.ndjson`, `outside.ndjson`, `runs.ndjson`, or `blobs/sha256/` and a file's SHA-256 for its bytes.",
          "type": "string",
          "pattern": "^([a-z]+\\.ndjson|blobs/sha256/[0-9a-f]{64})$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "$ref": "#/$defs/count"
        }
      },
      "additionalProperties": false
    },
    "plugin": {
      "type": "object",
      "required": ["name", "version", "sha", "types", "extensions"],
      "properties": {
        "name": {
          "description": "The plugin, such as `iki/protein`.",
          "$ref": "https://ikisci.org/schemas/field/v1#/$defs/pluginName"
        },
        "version": {
          "type": "string",
          "maxLength": 100
        },
        "sha": {
          "description": "The git commit it was built from, or empty for a local build.",
          "type": "string",
          "maxLength": 64
        },
        "extensions": {
          "description": "Its extensions of the bundle's types, by the type each extends, with each quantity field's unit.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["units"],
            "properties": {
              "units": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "types": {
          "description": "Its types the bundle has entities of, with their parents, by qualified name.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["schema_version", "units"],
            "properties": {
              "schema_version": {
                "type": "integer",
                "minimum": 1
              },
              "units": {
                "description": "Each quantity field's unit, which its values (in history too) are in.",
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "person": {
      "description": "A line of `people.ndjson`: someone a record names. The importing deployment matches them by email.",
      "type": "object",
      "required": ["id", "kind", "email", "name"],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "enum": ["person", "service"]
        },
        "email": {
          "type": "string",
          "maxLength": 320
        },
        "name": {
          "type": "string",
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "description": "A line of `agents.ndjson`: an agent that acted for a person (ADR 0072), as the source stored it.",
      "type": "object",
      "required": [
        "id",
        "key",
        "client_id",
        "client_name",
        "grant",
        "session",
        "software",
        "model",
        "first_seen_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "key": {
          "$ref": "#/$defs/sha256"
        },
        "client_id": {
          "type": "string",
          "maxLength": 255
        },
        "client_name": {
          "type": "string",
          "maxLength": 255
        },
        "grant": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "session": {
          "type": "string",
          "maxLength": 64
        },
        "software": {
          "type": "string",
          "maxLength": 255
        },
        "model": {
          "type": "string",
          "maxLength": 255
        },
        "first_seen_at": {
          "$ref": "#/$defs/time"
        }
      },
      "additionalProperties": false
    },
    "file": {
      "description": "A line of `files.ndjson`: a file a revision names. Iki's own files' bytes are the member `blobs/sha256/<sha256>`; a registered file's stay where they were registered.",
      "type": "object",
      "required": [
        "id",
        "name",
        "media_type",
        "created_at",
        "created_by",
        "agent",
        "sha256",
        "size",
        "registered"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "media_type": {
          "type": "string",
          "maxLength": 255
        },
        "created_at": {
          "$ref": "#/$defs/time"
        },
        "created_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "$ref": "#/$defs/count"
        },
        "registered": {
          "description": "For a file registered where it was (ADR 0055), not copied into Iki: its address and object version.",
          "anyOf": [
            {
              "type": "object",
              "required": ["uri", "version"],
              "properties": {
                "uri": {
                  "type": "string",
                  "maxLength": 2000
                },
                "version": {
                  "type": "string",
                  "maxLength": 1024
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "entity": {
      "description": "A line of `entities.ndjson`: an entity, with every revision and the values each table of it held at each.",
      "type": "object",
      "required": [
        "id",
        "type",
        "hrid",
        "created_at",
        "created_by",
        "archived_at",
        "revisions",
        "history"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "description": "Its type, such as `iki/protein.Protein`.",
          "type": "string",
          "maxLength": 81
        },
        "hrid": {
          "description": "Its HRID on the source deployment.",
          "type": "string",
          "maxLength": 32
        },
        "created_at": {
          "$ref": "#/$defs/time"
        },
        "created_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "archived_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "description": "Its state, for a record of a type with states (ADR 0118). An import that doesn't know it starts the record in its type's initial state.",
          "type": "string",
          "maxLength": 50
        },
        "entry": {
          "description": "For a record of a registry entry (ADR 0115), the entry's ID: a line of `entries.ndjson`. Its HRID is the entry's.",
          "$ref": "#/$defs/uuid"
        },
        "revisions": {
          "description": "Every revision, 1 first.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/revision"
          }
        },
        "history": {
          "description": "Each table's values at each revision that changed it, as the source's history keeps them.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/history"
          }
        }
      },
      "additionalProperties": false
    },
    "revision": {
      "type": "object",
      "required": [
        "id",
        "number",
        "kind",
        "changed_fields",
        "user",
        "via",
        "client",
        "agent",
        "reason",
        "created_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": ["created", "edited", "archived", "restored", "moved", "transitioned"]
        },
        "changed_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 63
          }
        },
        "user": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "via": {
          "type": "string",
          "maxLength": 16
        },
        "client": {
          "type": "string",
          "maxLength": 255
        },
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "created_at": {
          "$ref": "#/$defs/time"
        },
        "transition": {
          "description": "For a transition (ADR 0118): its name, and the states it went from and to.",
          "type": "object",
          "required": ["name", "from", "to"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 63
            },
            "from": {
              "type": "string",
              "maxLength": 50
            },
            "to": {
              "type": "string",
              "maxLength": 50
            }
          }
        }
      },
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "required": ["table", "revision", "values"],
      "properties": {
        "table": {
          "description": "The type in the entity's chain whose table it is, such as `iki/dna.Sequence`, or for an extension, its plugin and the type it extends, such as `acme/lims:iki/dna.DNASequence`.",
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*/[a-z][a-z0-9_]*:)?[a-z][a-z0-9_]*/[a-z][a-z0-9_]*\\.[A-Z][A-Za-z0-9]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "values": {
          "description": "Every field the table has had, by name: refs and files by UUID, dates and times in ISO 8601, quantities in their field's unit, removed fields as null.",
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "description": "A line of `entries.ndjson`: a registry entry the bundle's records are of (ADR 0115), with its identity, derived values and facts as they are now. Its history is its registry's, so it doesn't go: an import registers the identity in its project's registry, or finds it registered there.",
      "type": "object",
      "required": ["id", "type", "hrid", "values"],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "description": "The type it's registered as, such as `iki/small_molecule.Compound`.",
          "type": "string",
          "maxLength": 81
        },
        "hrid": {
          "description": "Its registry ID on the source deployment, such as `CPD-000123`.",
          "type": "string",
          "maxLength": 32
        },
        "values": {
          "description": "Its fields, by name, as `history` gives them.",
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "outside": {
      "description": "A line of `outside.ndjson`: an entity the bundle's values or runs refer to that isn't in it. Its HRID and type are given only if the exporter could read it.",
      "type": "object",
      "required": ["id", "hrid", "type", "why"],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "hrid": {
          "type": ["string", "null"],
          "maxLength": 32
        },
        "type": {
          "type": ["string", "null"],
          "maxLength": 81
        },
        "why": {
          "description": "`another-project`: owned by another project. `history`: only an earlier revision refers to it. `purged`: its plugin's data was purged. `run`: only a run's inputs or lineage refer to it. `unreadable`: the exporter can't read it.",
          "enum": ["another-project", "history", "purged", "run", "unreadable"]
        }
      },
      "additionalProperties": false
    },
    "run": {
      "description": "A line of `runs.ndjson`: a finished run that made or changed the bundle's entities, with what it read, each attempt and its log, and what it made of what.",
      "type": "object",
      "required": [
        "action",
        "agent",
        "approval",
        "attempts",
        "client",
        "created_at",
        "effects",
        "environment",
        "error",
        "finished_at",
        "hrid",
        "id",
        "inputs",
        "lineage",
        "linked",
        "max_attempts",
        "origins",
        "output",
        "params",
        "plugin_settings",
        "plugin_sha",
        "plugin_version",
        "reason",
        "reproduction",
        "requested_by",
        "retry_on",
        "seed",
        "spec",
        "started_at",
        "status",
        "tier",
        "timeout",
        "via"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "hrid": {
          "description": "Its HRID on the source deployment, such as RUN-000123.",
          "type": "string",
          "maxLength": 32
        },
        "action": {
          "description": "Such as `protein.compute_properties`.",
          "type": "string",
          "maxLength": 200
        },
        "plugin_version": {
          "type": "string",
          "maxLength": 100
        },
        "plugin_sha": {
          "description": "The plugin's commit, for reproducing it.",
          "type": "string",
          "maxLength": 40
        },
        "spec": {
          "description": "The action as it was when it ran.",
          "type": "object"
        },
        "requested_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "via": {
          "type": "string",
          "maxLength": 16
        },
        "client": {
          "type": "string",
          "maxLength": 255
        },
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "tier": {
          "type": "string",
          "maxLength": 16
        },
        "environment": {
          "type": "string",
          "maxLength": 63
        },
        "params": {
          "type": "object"
        },
        "plugin_settings": {
          "description": "The plugin's settings at launch (never secrets).",
          "type": "object"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "description": "How it ended: only finished runs go.",
          "enum": ["cancelled", "declined", "failed", "rejected", "succeeded", "timed_out"]
        },
        "created_at": {
          "$ref": "#/$defs/time"
        },
        "started_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "description": "Why it failed, if it did."
        },
        "timeout": {
          "$ref": "#/$defs/count"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "retry_on": {
          "type": "array"
        },
        "reproduction": {
          "description": "How it compared with the run it reproduced, if it reproduced one."
        },
        "linked": {
          "description": "Runs and their groups it's tied to on the source deployment, which don't go with it.",
          "type": "object",
          "required": ["batch", "reproduces", "reused_from", "workflow"],
          "properties": {
            "batch": {
              "anyOf": [
                {
                  "type": "object",
                  "required": ["hrid", "id"],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/uuid"
                    },
                    "hrid": {
                      "type": "string",
                      "maxLength": 32
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "workflow": {
              "anyOf": [
                {
                  "type": "object",
                  "required": ["hrid", "id", "step"],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/uuid"
                    },
                    "hrid": {
                      "type": "string",
                      "maxLength": 32
                    },
                    "step": {
                      "type": "string",
                      "maxLength": 63
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "reused_from": {
              "anyOf": [
                {
                  "type": "object",
                  "required": ["hrid", "id"],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/uuid"
                    },
                    "hrid": {
                      "type": "string",
                      "maxLength": 32
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "reproduces": {
              "anyOf": [
                {
                  "type": "object",
                  "required": ["hrid", "id"],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/uuid"
                    },
                    "hrid": {
                      "type": "string",
                      "maxLength": 32
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "approval": {
          "anyOf": [
            {
              "description": "Who approved it, when an agent asked for it (ADR 0072).",
              "type": "object",
              "required": [
                "agent",
                "client",
                "created_at",
                "decided_at",
                "decided_by",
                "note",
                "requested_by",
                "state"
              ],
              "properties": {
                "state": {
                  "type": "string",
                  "maxLength": 16
                },
                "requested_by": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "agent": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "client": {
                  "type": "string",
                  "maxLength": 255
                },
                "created_at": {
                  "$ref": "#/$defs/time"
                },
                "decided_by": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "decided_at": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity", "name", "position", "revision"],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 63
              },
              "position": {
                "$ref": "#/$defs/count"
              },
              "entity": {
                "$ref": "#/$defs/uuid"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "made_with": {
          "description": "The software Iki recorded it made each of the bundle's entities with (ADR 0106): its action's, or those its output named. Older bundles leave it out.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity", "software", "version", "created_at"],
            "additionalProperties": false,
            "properties": {
              "entity": {
                "$ref": "#/$defs/uuid"
              },
              "software": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "version": {
                "type": "string",
                "maxLength": 100
              },
              "created_at": {
                "$ref": "#/$defs/time"
              }
            }
          }
        },
        "included": {
          "description": "What its inputs' references named, that it read too (ADR 0105): only on runs that read any.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity", "field", "index", "input", "position", "revision"],
            "properties": {
              "input": {
                "type": "string",
                "maxLength": 63
              },
              "position": {
                "$ref": "#/$defs/count"
              },
              "field": {
                "type": "string",
                "maxLength": 63
              },
              "index": {
                "$ref": "#/$defs/count"
              },
              "entity": {
                "$ref": "#/$defs/uuid"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "effects": {
          "description": "What it did to the bundle's entities.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity", "kind", "revision"],
            "properties": {
              "entity": {
                "$ref": "#/$defs/uuid"
              },
              "kind": {
                "type": "string",
                "maxLength": 16
              },
              "revision": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "lineage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity", "input", "parent", "parent_revision"],
            "properties": {
              "entity": {
                "$ref": "#/$defs/uuid"
              },
              "parent": {
                "$ref": "#/$defs/uuid"
              },
              "parent_revision": {
                "type": "integer",
                "minimum": 1
              },
              "input": {
                "type": "string",
                "maxLength": 63
              }
            },
            "additionalProperties": false
          }
        },
        "origins": {
          "description": "The public records it read the bundle's entities from.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "created_at",
              "entity",
              "file",
              "identifier",
              "retrieved_at",
              "revision",
              "sha256",
              "source",
              "url",
              "version"
            ],
            "properties": {
              "entity": {
                "$ref": "#/$defs/uuid"
              },
              "revision": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source": {
                "type": "string",
                "maxLength": 100
              },
              "identifier": {
                "type": "string",
                "maxLength": 255
              },
              "version": {
                "type": "string",
                "maxLength": 100
              },
              "url": {
                "type": "string",
                "maxLength": 2000
              },
              "retrieved_at": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sha256": {
                "type": "string",
                "maxLength": 64
              },
              "file": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "made": {
                "description": "How the record says its source made the entity (ADR 0106).",
                "anyOf": [
                  {
                    "$ref": "https://ikisci.org/schemas/run-output/v1#/$defs/made"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "created_at": {
                "$ref": "#/$defs/time"
              }
            },
            "additionalProperties": false
          }
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "attempt",
              "environment",
              "environment_build",
              "error",
              "finished_at",
              "id",
              "log",
              "owner",
              "queued_at",
              "resources",
              "started_at",
              "state",
              "tier",
              "volumes",
              "worker"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/uuid"
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "state": {
                "enum": ["cancelled", "failed", "interrupted", "rejected", "succeeded", "timed_out"]
              },
              "tier": {
                "type": "string",
                "maxLength": 16
              },
              "environment": {
                "type": "string",
                "maxLength": 200
              },
              "environment_build": {
                "type": "string",
                "maxLength": 100
              },
              "resources": {
                "type": "object"
              },
              "worker": {
                "description": "The worker's name.",
                "type": "string",
                "maxLength": 255
              },
              "queued_at": {
                "$ref": "#/$defs/time"
              },
              "started_at": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "finished_at": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "error": {},
              "log": {
                "description": "Everything it printed.",
                "type": "string"
              },
              "owner": {
                "description": "Always null: workers once ran on people's own computers, which self-hosted workers replaced (ADR 0112).",
                "anyOf": [
                  {
                    "$ref": "#/$defs/uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "volumes": {
                "description": "The versions of its environment's volumes it had (ADR 0075).",
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "output": {
          "anyOf": [
            {
              "type": "object",
              "required": ["document", "job", "received_at"],
              "properties": {
                "job": {
                  "$ref": "#/$defs/uuid"
                },
                "document": {
                  "type": "object"
                },
                "received_at": {
                  "$ref": "#/$defs/time"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
