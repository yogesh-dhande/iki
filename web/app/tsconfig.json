{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Workspace packages resolve to their sources, so nothing needs building first.
    "customConditions": ["@ikisci/source"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
