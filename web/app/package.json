{
  "name": "@ikisci/app",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Iki's web app: the React host the server serves at / and /projects/.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:wasm && vite",
    "build": "pnpm build:wasm && pnpm build:web",
    "build:wasm": "../../scripts/build-wasm.sh",
    "build:web": "vite build && vite build -c vite.structure.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fonts": "cp node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2 node_modules/@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2 node_modules/@fontsource-variable/inter/files/inter-greek-wght-normal.woff2 ../../server/src/iki_server/web/static/iki/fonts/ && cp node_modules/@fontsource-variable/inter/LICENSE ../../server/src/iki_server/web/static/iki/fonts/inter-LICENSE.txt"
  },
  "dependencies": {
    "@bwip-js/browser": "4.11.4",
    "@ikisci/science": "workspace:*",
    "@ikisci/sdk": "workspace:*",
    "@ikisci/ui": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.26",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "react-stately": "^3.51.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "vite": "^8.3.8"
  }
}
