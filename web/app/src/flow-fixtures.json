    {
      "type": "iki/lots.Lot",
      "label": "Lot",
      "fields": [
        {
          "name": "disposition",
          "label": "Disposition",
          "initial": "quarantined",
          "states": [
            {
              "name": "quarantined",
              "label": "Quarantined",
              "description": "Made or received, and not yet released. It can be drawn from to be tested.",
              "set_by": ["iki/lots.qa"],
              "locks": false,
              "on_edit": null,
              "holds_amount": false,
              "reason": "required",
              "guards": [
                {
                  "name": "reopened",
                  "description": "A released lot goes back to quarantine only to correct it, saying why.",
                  "check": "state.from == \"released\" || state.from == \"on_hold\"",
                  "when": null,
                  "message": "A lot goes back to quarantine from Released or On hold."
                }
              ],
              "signatures": []
            },
            {
              "name": "released",
              "label": "Released",
              "description": "QA released it for use. Its values can't change while it's released.",
              "set_by": ["iki/lots.qa"],
              "locks": true,
              "on_edit": null,
              "holds_amount": false,
              "reason": null,
              "guards": [
                {
                  "name": "from_quarantine",
                  "description": "A lot is released from quarantine, or once a hold is lifted.",
                  "check": "state.from == \"quarantined\" || state.from == \"on_hold\"",
                  "when": null,
                  "message": "A lot is released from Quarantined or On hold."
                },
                {
                  "name": "has_a_certificate",
                  "description": "QA releases a lot on its certificate of analysis.",
                  "check": "size(record.certificates) > 0",
                  "when": null,
                  "message": "Attach its certificate of analysis before releasing it."
                },
                {
                  "name": "says_where_it_came_from",
                  "description": "QA releases a lot knowing whether it was made or bought.",
                  "check": "record.source != null",
                  "when": null,
                  "message": "Say whether it was made or bought before releasing it."
                },
                {
                  "name": "names_its_maker",
                  "description": "A lot made in the lab names who made it, so QA can see it isn't releasing its own work.",
                  "check": "record.source != \"made\" || record.made_by != null",
                  "when": null,
                  "message": "Say who made it before releasing it."
                },
                {
                  "name": "not_its_maker",
                  "description": "Whoever made a lot doesn't release it; a second person checks it.",
                  "check": "record.made_by == null || record.made_by != actor.person",
                  "when": null,
                  "message": "You made this lot, so someone else in QA releases it."
                },
                {
                  "name": "not_who_recorded_it",
                  "description": "Whoever recorded a lot made in the lab doesn't release it either: Iki knows who that was, whoever it says made it.",
                  "check": "record.source != \"made\" || history.disposition[0].by != actor.person",
                  "when": null,
                  "message": "You recorded this lot, so someone else in QA releases it."
                },
                {
                  "name": "not_who_edited_it",
                  "description": null,
                  "check": "edits.disposition.quarantined.all(e, e.by != actor.person)",
                  "when": "record.source == \"made\"",
                  "message": "You edited this lot's record, so someone else in QA releases it."
                },
                {
                  "name": "a_person",
                  "description": null,
                  "check": "actor.agent == null",
                  "when": null,
                  "message": "Release it yourself, in Iki, not through an app or agent."
                }
              ],
              "signatures": [
                {
                  "meaning": "approval",
                  "meaning_label": "Approval",
                  "verb": "Approved",
                  "label": "QA release",
                  "statement": "I release this lot for use: its records and certificate of analysis meet its specification.",
                  "roles": ["iki/lots.qa"]
                }
              ]
            },
            {
              "name": "on_hold",
              "label": "On hold",
              "description": "Kept from use while something is looked into, such as a deviation or a result out of its specification.",
              "set_by": ["iki/lots.qa"],
              "locks": false,
              "on_edit": null,
              "holds_amount": true,
              "reason": "required",
              "guards": [
                {
                  "name": "not_rejected",
                  "description": null,
                  "check": "state.from != \"rejected\" && state.from != \"expired\"",
                  "when": null,
                  "message": "A rejected or expired lot isn't put on hold."
                }
              ],
              "signatures": []
            },
            {
              "name": "rejected",
              "label": "Rejected",
              "description": "It doesn't meet its specification. It's kept, with its records, but not used.",
              "set_by": ["iki/lots.qa"],
              "locks": true,
              "on_edit": null,
              "holds_amount": true,
              "reason": "required",
              "guards": [],
              "signatures": [
                {
                  "meaning": "responsibility",
                  "meaning_label": "Responsibility",
                  "verb": "Signed off",
                  "label": "QA rejection",
                  "statement": "I reject this lot; it isn't to be used.",
                  "roles": ["iki/lots.qa"]
                }
              ]
            },
            {
              "name": "expired",
              "label": "Expired",
              "description": "Past its expiry or retest date. It's kept, but not used.",
              "set_by": ["iki/lots.qa"],
              "locks": true,
              "on_edit": null,
              "holds_amount": true,
              "reason": "optional",
              "guards": [
                {
                  "name": "past_its_date",
                  "description": "A lot expires once its expiry or retest date has come.",
                  "check": "(record.expires_on != null && record.expires_on <= today) || (record.retest_on != null && record.retest_on <= today)",
                  "when": null,
                  "message": "Its expiry and retest dates haven't come, so it hasn't expired."
                }
              ],
              "signatures": []
            }
          ]
        }
      ]
    },
