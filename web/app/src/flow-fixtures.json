{
  "roles": {
    "iki/lab_roles.analyst": "Analyst",
    "iki/lab_roles.coordinator": "Coordinator",
    "iki/lab_roles.engineer": "Engineer",
    "iki/lab_roles.qa": "Sample and result QA",
    "iki/lab_roles.reviewer": "Reviewer",
    "iki/lots.qa": "Lot QA",
    "iki/lots.verification_analyst": "Verification analyst",
    "iki/lots.verification_reviewer": "Verification reviewer",
    "iki/plate_assays.analyst": "Assay analyst",
    "iki/plate_assays.qa": "Assay QA",
    "iki/plate_assays.reviewer": "Assay reviewer"
  },
  "types": [
    {
      "type": "iki/requests.QCDeliverable",
      "label": "QC deliverable",
      "fields": [
        {
          "name": "review",
          "label": "Review",
          "initial": "recorded",
          "states": [
            {
              "name": "recorded",
              "label": "Recorded",
              "description": null,
              "set_by": ["iki/lab_roles.analyst", "iki/lab_roles.reviewer", "iki/lab_roles.qa"],
              "locks": false,
              "on_edit": null,
              "holds_amount": false,
              "reason": "required",
              "guards": [
                {
                  "name": "before_release",
                  "description": null,
                  "check": "state.from == \"submitted\" || state.from == \"reviewed\"",
                  "when": null,
                  "message": "Only a submitted or reviewed deliverable can return to Recorded."
                }
              ],
              "signatures": []
            },
            {
              "name": "submitted",
              "label": "Submitted",
              "description": null,
              "set_by": ["iki/lab_roles.analyst"],
              "locks": true,
              "on_edit": null,
              "holds_amount": false,
              "reason": null,
              "guards": [
                {
                  "name": "recorded",
                  "description": null,
                  "check": "state.from == \"recorded\"",
                  "when": null,
                  "message": "Submit the deliverable from Recorded."
                },
                {
                  "name": "has_sample",
                  "description": null,
                  "check": "record.material != null",
                  "when": "record.analysis != null",
                  "message": "Name the sample that was measured."
                },
                {
                  "name": "has_result",
                  "description": null,
                  "check": "record.result != null",
                  "when": "record.analysis != null",
                  "message": "Record whether the sample passed or failed."
                },
                {
                  "name": "has_purity",
                  "description": null,
                  "check": "record.purity != null",
                  "when": "record.analysis == \"sec_purity\"",
                  "message": "Record the SEC purity as a percentage."
                },
                {
                  "name": "has_mass",
                  "description": null,
                  "check": "record.measured_mass != null",
                  "when": "record.analysis == \"intact_mass\"",
                  "message": "Record the measured intact mass."
                },
                {
                  "name": "has_coverage",
                  "description": null,
                  "check": "record.peptide_coverage != null",
                  "when": "record.analysis == \"peptide_map\"",
                  "message": "Record the percentage of the protein sequence covered by the peptide map."
                },
                {
                  "name": "has_endotoxin",
                  "description": null,
                  "check": "record.endotoxin != null",
                  "when": "record.analysis == \"endotoxin\"",
                  "message": "Record the endotoxin units per milligram of protein."
                },
                {
                  "name": "active_request",
                  "description": null,
                  "check": "record.request.standing == \"open\" && record.request.status == \"in_progress\"",
                  "when": null,
                  "message": "Sign the deliverable while the request is open and in progress at the service."
                },
                {
                  "name": "measured_scope",
                  "description": null,
                  "check": "record.analysis != null && record.request.analyses != null && record.analysis in record.request.analyses && size(covered_subjects) > 0",
                  "when": "record.analysis != null || (record.request.analyses != null && size(record.request.analyses) > 0)",
                  "message": "The measurement must still answer this request for the material it sent."
                },
                {
                  "name": "scope_still_matches",
                  "description": null,
                  "check": "record.request.facility_service == \"protein_production\" ? (record.protein != null && record.protein.id in record.request.records) : (record.request.facility_service != \"sequencing\" ||\n covered_subjects.exists(id, id in record.request.tubes))",
                  "when": null,
                  "message": "The protein or tube must still be on the request."
                }
              ],
              "signatures": [
                {
                  "meaning": "authorship",
                  "meaning_label": "Authorship",
                  "verb": "Authored",
                  "label": "Authorship",
                  "statement": "I recorded this deliverable and its evidence.",
                  "roles": ["iki/lab_roles.analyst"]
                }
              ]
            },
            {
              "name": "reviewed",
              "label": "Reviewed",
              "description": null,
              "set_by": ["iki/lab_roles.reviewer"],
              "locks": true,
              "on_edit": null,
              "holds_amount": false,
              "reason": null,
              "guards": [
                {
                  "name": "submitted",
                  "description": null,
                  "check": "state.from == \"submitted\"",
                  "when": null,
                  "message": "Review the deliverable after its analyst submits it."
                },
                {
                  "name": "independent_review",
                  "description": null,
                  "check": "history.review[0].by != actor.person && last.review.submitted.by != actor.person && edits.review.recorded.all(e, e.by != actor.person)",
                  "when": null,
                  "message": "Have a reviewer who did not create, submit or edit the deliverable sign it."
                },
                {
                  "name": "active_request",
                  "description": null,
                  "check": "record.request.standing == \"open\" && record.request.status == \"in_progress\"",
                  "when": null,
                  "message": "Sign the deliverable while the request is open and in progress at the service."
                },
                {
                  "name": "measured_scope",
                  "description": null,
                  "check": "record.analysis != null && record.request.analyses != null && record.analysis in record.request.analyses && size(covered_subjects) > 0",
                  "when": "record.analysis != null || (record.request.analyses != null && size(record.request.analyses) > 0)",
                  "message": "The measurement must still answer this request for the material it sent."
                },
                {
                  "name": "scope_still_matches",
                  "description": null,
                  "check": "record.request.facility_service == \"protein_production\" ? (record.protein != null && record.protein.id in record.request.records) : (record.request.facility_service != \"sequencing\" ||\n covered_subjects.exists(id, id in record.request.tubes))",
                  "when": null,
                  "message": "The protein or tube must still be on the request."
                }
              ],
              "signatures": [
                {
                  "meaning": "review",
                  "meaning_label": "Review",
                  "verb": "Reviewed",
                  "label": "Review",
                  "statement": "I reviewed the delivery report, outcome, and supporting evidence.",
                  "roles": ["iki/lab_roles.reviewer"]
                }
              ]
            },
            {
              "name": "released",
              "label": "Released",
              "description": null,
              "set_by": ["iki/lab_roles.qa"],
              "locks": true,
              "on_edit": null,
              "holds_amount": false,
              "reason": null,
              "guards": [
                {
                  "name": "reviewed",
                  "description": null,
                  "check": "state.from == \"reviewed\" && last.review.reviewed.from == \"submitted\"",
                  "when": null,
                  "message": "Release the submitted deliverable after its independent review."
                },
                {
                  "name": "independent_release",
                  "description": null,
                  "check": "history.review[0].by != actor.person && last.review.submitted.by != actor.person && last.review.reviewed.by != actor.person && edits.review.recorded.all(e, e.by != actor.person)",
                  "when": null,
                  "message": "Have someone in QA who did not create, submit, edit or review the deliverable release it."
                },
                {
                  "name": "active_request",
                  "description": null,
                  "check": "record.request.standing == \"open\" && record.request.status == \"in_progress\"",
                  "when": null,
                  "message": "Sign the deliverable while the request is open and in progress at the service."
                },
                {
                  "name": "measured_scope",
                  "description": null,
                  "check": "record.analysis != null && record.request.analyses != null && record.analysis in record.request.analyses && size(covered_subjects) > 0",
                  "when": "record.analysis != null || (record.request.analyses != null && size(record.request.analyses) > 0)",
                  "message": "The measurement must still answer this request for the material it sent."
                },
                {
                  "name": "scope_still_matches",
                  "description": null,
                  "check": "record.request.facility_service == \"protein_production\" ? (record.protein != null && record.protein.id in record.request.records) : (record.request.facility_service != \"sequencing\" ||\n covered_subjects.exists(id, id in record.request.tubes))",
                  "when": null,
                  "message": "The protein or tube must still be on the request."
                }
              ],
              "signatures": [
                {
                  "meaning": "approval",
                  "meaning_label": "Approval",
                  "verb": "Approved",
                  "label": "QA release",
                  "statement": "I release the independently reviewed deliverable to the requesting project.",
                  "roles": ["iki/lab_roles.qa"]
                }
              ]
            }
          ],
          "transitions": [
            {
              "from": "submitted",
              "to": "recorded",
              "conditional": false
            },
            {
              "from": "reviewed",
              "to": "recorded",
              "conditional": false
            },
            {
              "from": "recorded",
              "to": "submitted",
              "conditional": true
            },
            {
              "from": "submitted",
              "to": "reviewed",
              "conditional": true
            },
            {
              "from": "reviewed",
              "to": "released",
              "conditional": true
            }
          ]
        }
      ]
    },
