            {
              "name": "approved",
              "label": "Approved",
              "description": "A reviewer checked its results; they can't change now.",
              "set_by": ["iki/example_lims.reviewer"],
              "locks": true,
              "on_edit": "in_testing",
              "holds_amount": false,
              "reason": null,
              "guards": [
                {
                  "name": "reviewed",
                  "description": "Only a sample in review is approved.",
                  "check": "state.from == \"in_review\"",
                  "when": null,
                  "message": "A sample is approved from In review."
                },
                {
                  "name": "four_eyes",
                  "description": "Whoever submitted it for review doesn't approve it: a second person checks the first's work.",
                  "check": "last.status.in_review == null || last.status.in_review.by != actor.person",
                  "when": null,
                  "message": "You submitted it for review, so someone else approves it."
                },
                {
                  "name": "independent_measurement",
                  "description": null,
                  "check": "edits.status.in_testing.all(e, e.by != actor.person || !e.fields.exists(f, f in [\"purity\", \"concentration\", \"result\", \"notes\"]))",
                  "when": null,
                  "message": "You edited the test results, so someone else approves this sample."
                }
              ],
              "signatures": [
                {
                  "meaning": "review",
                  "meaning_label": "Review",
                  "verb": "Reviewed",
                  "label": "Review",
                  "statement": "I reviewed this record and found it in order.",
                  "roles": ["iki/example_lims.reviewer"]
                }
              ]
            },
            {
              "name": "released",
              "label": "Released",
              "description": "QA released it, so its results can be used.",
              "set_by": ["iki/example_lims.qa"],
              "locks": true,
              "on_edit": null,
              "holds_amount": false,
              "reason": "optional",
              "guards": [
                {
                  "name": "approved",
                  "description": "Only an approved sample is released.",
                  "check": "state.from == \"approved\"",
                  "when": null,
                  "message": "A sample is released once it's approved."
                },
                {
                  "name": "passed",
                  "description": null,
                  "check": "record.result == \"pass\"",
                  "when": null,
                  "message": "Only a sample that passed is released; reject one that failed."
                },
                {
                  "name": "not_its_approver",
                  "description": null,
                  "check": "last.status.approved == null || last.status.approved.by != actor.person",
                  "when": null,
                  "message": "You approved it, so someone else in QA releases it."
                },
                {
                  "name": "independent_measurement",
                  "description": null,
                  "check": "edits.status.in_testing.all(e, e.by != actor.person || !e.fields.exists(f, f in [\"purity\", \"concentration\", \"result\", \"notes\"]))",
                  "when": null,
                  "message": "You edited the test results, so someone else in QA releases this sample."
                }
              ],
              "signatures": [
                {
                  "meaning": "approval",
                  "meaning_label": "Approval",
                  "verb": "Approved",
                  "label": "QA release",
                  "statement": "I release this sample for use.",
                  "roles": ["iki/example_lims.qa"]
                }
              ]
            },
            {
              "name": "rejected",
              "label": "Rejected",
              "description": "QA rejected it; it's kept, with its results, but not used.",
              "set_by": ["iki/example_lims.qa"],
              "locks": true,
              "on_edit": null,
              "holds_amount": true,
              "reason": "required",
              "guards": [
                {
                  "name": "reviewed",
                  "description": "QA rejects a sample once it's been reviewed.",
                  "check": "state.from == \"approved\" || state.from == \"in_review\"",
                  "when": null,
                  "message": "A sample is rejected once it's in review or approved."
                }
              ],
              "signatures": [
                {
                  "meaning": "responsibility",
                  "meaning_label": "Responsibility",
                  "verb": "Signed off",
                  "label": "QA rejection",
                  "statement": "I reject this sample; it isn't to be used.",
                  "roles": ["iki/example_lims.qa"]
                }
              ]
            }
          ]
        }
      ]
