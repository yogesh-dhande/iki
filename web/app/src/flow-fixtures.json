    "iki/example_lims.coordinator": "Coordinator",
    "iki/example_lims.engineer": "Engineer",
    "iki/example_lims.qa": "Sample and result QA",
    "iki/example_lims.reviewer": "Reviewer",
    "iki/lots.qa": "Lot QA",
    "iki/plate_assays.analyst": "Assay analyst",
    "iki/plate_assays.qa": "Assay QA",
    "iki/plate_assays.reviewer": "Assay reviewer"
  },
  "types": [
    {
      "type": "iki/example_lims.AnalysisResult",
      "label": "Analysis result",
      "fields": [
        {
          "name": "review",
          "label": "Review",
          "initial": "draft",
          "states": [
            {
              "name": "draft",
              "label": "Draft",
              "description": "Its analyst is recording or correcting the measurement.",
              "set_by": [
                "iki/example_lims.analyst",
                "iki/example_lims.reviewer",
                "iki/example_lims.qa"
              ],
              "locks": false,
              "on_edit": null,
              "holds_amount": false,
              "reason": "required",
              "guards": [
                {
                  "name": "before_release",
                  "description": null,
                  "check": "state.from == \"in_review\" || state.from == \"reviewed\"",
                  "when": null,
                  "message": "Only a result awaiting review or release can be returned for correction."
                }
              ],
              "signatures": []
            },
            {
              "name": "in_review",
              "label": "In review",
              "description": "The analyst has signed the measurement and submitted it for review.",
              "set_by": ["iki/example_lims.analyst"],
              "locks": true,
              "on_edit": "draft",
              "holds_amount": false,
              "reason": null,
              "guards": [
                {
                  "name": "from_draft",
                  "description": null,
                  "check": "state.from == \"draft\"",
                  "when": null,
                  "message": "Submit the result from Draft."
                },
                {
                  "name": "has_sample",
                  "description": null,
                  "check": "record.sample != null",
                  "when": null,
                  "message": "Name the sample that was measured."
                },
                {
                  "name": "has_result",
                  "description": null,
                  "check": "record.result != null",
                  "when": null,
                  "message": "Record whether the sample passed or failed."
                },
                {
                  "name": "has_purity",
                  "description": null,
                  "check": "record.purity != null",
                  "when": "record.analysis == \"sec_purity\"",
                  "message": "Record the SEC purity as a percentage."
                },
                {
                  "name": "has_mass",
                  "description": null,
                  "check": "record.measured_mass != null",
                  "when": "record.analysis == \"intact_mass\"",
                  "message": "Record the measured intact mass."
                },
                {
                  "name": "has_coverage",
                  "description": null,
                  "check": "record.peptide_coverage != null",
                  "when": "record.analysis == \"peptide_map\"",
                  "message": "Record the percentage of the protein sequence covered by the peptide map."
                },
                {
                  "name": "has_endotoxin",
                  "description": null,
                  "check": "record.endotoxin != null",
                  "when": "record.analysis == \"endotoxin\"",
                  "message": "Record the endotoxin units per milligram of protein."
                }
              ],
              "signatures": [
                {
                  "meaning": "authorship",
                  "meaning_label": "Authorship",
                  "verb": "Authored",
                  "label": "Authorship",
                  "statement": "I recorded this measurement and its result as observed.",
                  "roles": ["iki/example_lims.analyst"]
                }
              ]
            },
            {
              "name": "reviewed",
              "label": "Reviewed",
              "description": "An independent reviewer has checked the submitted measurement.",
              "set_by": ["iki/example_lims.reviewer"],
              "locks": true,
              "on_edit": "draft",
              "holds_amount": false,
              "reason": null,
              "guards": [
                {
                  "name": "submitted",
                  "description": null,
                  "check": "state.from == \"in_review\"",
                  "when": null,
                  "message": "Review the result after its analyst submits it."
                },
                {
                  "name": "independent_reviewer",
                  "description": null,
                  "check": "history.review[0].by != actor.person && last.review.in_review.by != actor.person",
                  "when": null,
                  "message": "Someone other than the result's creator and submitting analyst must review it."
                },
                {
                  "name": "independent_of_edits",
                  "description": null,
                  "check": "edits.review.draft.all(e, e.by != actor.person)",
                  "when": null,
                  "message": "You edited this result in its current review cycle, so someone else reviews it."
                }
              ],
              "signatures": [
                {
                  "meaning": "review",
                  "meaning_label": "Review",
                  "verb": "Reviewed",
                  "label": "Review",
                  "statement": "I reviewed this record and found it in order.",
                  "roles": ["iki/example_lims.reviewer"]
                }
              ]
            },
            {
              "name": "released",
              "label": "Released",
              "description": "QA has released the reviewed measurement to the project that asked.",
              "set_by": ["iki/example_lims.qa"],
              "locks": true,
              "on_edit": null,
              "holds_amount": false,
              "reason": null,
              "guards": [
                {
                  "name": "reviewed",
                  "description": null,
                  "check": "state.from == \"reviewed\" && last.review.reviewed.from == \"in_review\"",
                  "when": null,
                  "message": "QA can release a result after a reviewer signs the analyst's submission."
                },
                {
                  "name": "independent_release",
                  "description": null,
                  "check": "last.review.reviewed.by != actor.person",
                  "when": null,
                  "message": "You reviewed this result, so someone else in QA releases it."
                },
                {
                  "name": "independent_of_analyst",
                  "description": null,
                  "check": "history.review[0].by != actor.person && last.review.in_review.by != actor.person",
                  "when": null,
                  "message": "You created or submitted this result, so someone else in QA releases it."
                },
                {
                  "name": "independent_of_edits",
                  "description": null,
                  "check": "edits.review.draft.all(e, e.by != actor.person)",
                  "when": null,
                  "message": "You edited this result in its current review cycle, so someone else in QA releases it."
                }
              ],
              "signatures": [
                {
                  "meaning": "approval",
                  "meaning_label": "Approval",
                  "verb": "Approved",
                  "label": "QA release",
                  "statement": "I release these results to the project that requested them.",
                  "roles": ["iki/example_lims.qa"]
                }
              ]
            }
          ]
        }
      ]
    },
