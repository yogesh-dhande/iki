    {
      "type": "iki/samples.ReviewedSample",
      "label": "Reviewed sample",
      "fields": [
        {
          "name": "status",
          "label": "Status",
          "initial": "pending",
          "states": [
            {
              "name": "pending",
              "label": "Awaiting draw",
              "description": null,
              "set_by": [],
              "locks": false,
              "on_edit": null,
              "holds_amount": false,
              "reason": null,
              "guards": [],
              "signatures": []
            },
            {
              "name": "received",
              "label": "Received",
              "description": null,
              "set_by": ["iki/lab_roles.coordinator", "iki/lab_roles.analyst"],
              "locks": false,
              "on_edit": null,
              "holds_amount": false,
              "reason": null,
              "guards": [
                {
                  "name": "drawn",
                  "description": null,
                  "check": "state.from == \"pending\" && size(draws) == 1",
                  "when": null,
                  "message": "Record the draw from the assigned source before receiving this sample."
                }
              ],
              "signatures": []
            },
            {
              "name": "in_testing",
              "label": "In testing",
              "description": null,
              "set_by": ["iki/lab_roles.analyst"],
              "locks": false,
              "on_edit": null,
              "holds_amount": false,
              "reason": null,
              "guards": [
                {
                  "name": "received",
                  "description": null,
                  "check": "state.from == \"received\"",
                  "when": null,
                  "message": "Receive the sample before testing it."
                }
              ],
              "signatures": []
            },
            {
              "name": "in_review",
              "label": "In review",
              "description": null,
              "set_by": ["iki/lab_roles.analyst"],
              "locks": true,
              "on_edit": null,
              "holds_amount": false,
              "reason": null,
              "guards": [
                {
                  "name": "tested",
                  "description": null,
                  "check": "state.from in [\"in_testing\", \"retesting\"] && record.measurements != null && size(record.measurements) > 0",
                  "when": null,
                  "message": "Record at least one measurement in testing before submitting for review."
                }
              ],
              "signatures": [
                {
                  "meaning": "authorship",
                  "meaning_label": "Authorship",
                  "verb": "Authored",
                  "label": "Authorship",
                  "statement": "I recorded these measurements as observed.",
                  "roles": ["iki/lab_roles.analyst"]
                }
              ]
            },
            {
              "name": "reviewed",
              "label": "Reviewed",
              "description": null,
              "set_by": ["iki/lab_roles.reviewer"],
              "locks": true,
              "on_edit": null,
              "holds_amount": false,
              "reason": null,
              "guards": [
                {
                  "name": "submitted",
                  "description": null,
                  "check": "state.from == \"in_review\"",
                  "when": null,
                  "message": "Review the signed submission."
                },
                {
                  "name": "independent",
                  "description": null,
                  "check": "last.status.in_review.by != actor.person && (last.status.retesting == null ?\n edits.status.pending + edits.status.received + edits.status.in_testing :\n edits.status.retesting).all(e, e.by != actor.person || !e.fields.exists(f, f in [\"measurements\", \"notes\"]))",
                  "when": null,
                  "message": "Someone other than the submitter and measurement editors must review this testing cycle."
                }
              ],
              "signatures": [
                {
                  "meaning": "review",
                  "meaning_label": "Review",
                  "verb": "Reviewed",
                  "label": "Review",
                  "statement": "I reviewed this record and found it in order.",
                  "roles": ["iki/lab_roles.reviewer"]
                }
              ]
            },
            {
              "name": "retesting",
              "label": "Returned to testing",
              "description": null,
              "set_by": ["iki/lab_roles.reviewer"],
              "locks": false,
              "on_edit": null,
              "holds_amount": false,
              "reason": "required",
              "guards": [
                {
                  "name": "signed",
                  "description": null,
                  "check": "state.from in [\"in_review\", \"reviewed\"]",
                  "when": null,
                  "message": "Return a submitted or reviewed sample to testing."
                }
              ],
              "signatures": [
                {
                  "meaning": "responsibility",
                  "meaning_label": "Responsibility",
                  "verb": "Signed off",
                  "label": "Responsibility",
                  "statement": "I return these measurements to testing for the reason recorded.",
                  "roles": ["iki/lab_roles.reviewer"]
                }
              ]
            }
          ],
          "transitions": [
            {
              "from": "pending",
              "to": "received",
              "conditional": true
            },
            {
              "from": "received",
              "to": "in_testing",
              "conditional": false
            },
            {
              "from": "in_testing",
              "to": "in_review",
              "conditional": true
            },
            {
              "from": "retesting",
              "to": "in_review",
              "conditional": true
            },
            {
              "from": "in_review",
              "to": "reviewed",
              "conditional": true
            },
            {
              "from": "in_review",
              "to": "retesting",
              "conditional": false
            },
            {
              "from": "reviewed",
              "to": "retesting",
              "conditional": false
            }
          ]
        }
      ]
    },
