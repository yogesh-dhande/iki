        "plugin": "core",
        "name": "App",
        "schema_version": 1,
        "label": "App",
        "label_plural": "Apps",
        "description": "A page of Iki's own components, each panel bound to those before it by expressions.",
        "extends": null,
        "abstract": false,
        "hrid_prefix": "APP",
        "hrid_digits": 6,
        "identity": [],
        "on_duplicate": null,
        "fields": {
          "name": {
            "name": "name",
            "type": "string",
            "label": "Name",
            "description": null,
            "required": true,
            "immutable": false,
