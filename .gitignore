# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Python
__pycache__/
*.py[cod]
.venv/
.venv-py312/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.static/
dist/
build/
*.egg-info/

# Node
node_modules/
.pnpm-store/
*.tsbuildinfo
