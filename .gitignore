# Rust
target/

# The built web app (`pnpm build`); images build their own
server/src/iki_server/web/static/app/
server/src/iki_server/web/static/viewers/
# iki-wasm, built for the web app and the server by scripts/build-wasm.sh, and by the
# images. The DNA plugin's offline measurement is added to its archive at build time.
web/app/wasm/
*.wasm
spec/src/iki_spec/rust-standard-library.html

# Local environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# OpenTofu: providers it downloads, and state, which never belongs in git.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# deploy/aws/production: a deployment's own inputs and what it writes out.
deploy/aws/production/terraform.tfvars
deploy/aws/production/backend.hcl
deploy/aws/production/values-aws.yaml
# deploy/gcp/production: the same.
deploy/gcp/production/terraform.tfvars
deploy/gcp/production/backend.hcl
deploy/gcp/production/values-gcp.yaml
# deploy/gcp/scripts/teardown.sh: the key rings whose versions it destroys.
deploy/gcp/*/.teardown-key-rings

# Claude Code's git worktrees: other checkouts of this repository.
.claude/worktrees/

# The docs site: what `python -m sitegen generate` writes, and what Astro builds.
docs/site/src/generated/
docs/site/.astro/
