      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"iki-server\"}[$__rate_interval]))))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "id": 18
    },
    {
      "type": "timeseries",
      "title": "Database queries",
      "description": "The 95th percentile time a query takes, by service.",
      "datasource": {
