{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "image",
    "environment",
    "publicUrl",
    "allowedHosts",
    "secretKey",
    "encryptionKeys",
    "database"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Deployment name, e.g. prod"
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^https?://[^/?#]+/?$",
      "description": "Base URL users open Iki at, e.g. https://iki.example.com"
    },
    "allowedHosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "https": {
      "type": "boolean"
    },
    "forwardedAllowIps": {
      "type": "string",
      "minLength": 1
    },
    "log": {
      "type": "object",
      "properties": {
        "level": {
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR"]
        },
        "format": {
          "enum": ["json", "console"]
        }
      }
    },
    "secretKey": {
      "type": "object",
      "required": ["existingSecret", "key"],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "encryptionKeys": {
      "type": "object",
      "required": ["existingSecret", "key"],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sessions": {
      "type": "object",
      "properties": {
        "idleTimeoutMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 10080
        },
        "maxAgeHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 720
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "rateLimitPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "oauth": {
      "type": "object",
      "properties": {
        "accessTokenMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440
        },
        "refreshTokenDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "clientMetadataDocuments": {
          "type": "boolean"
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["existingSecret", "uriKey", "sslmode", "migrator"],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "uriKey": {
          "type": "string",
          "minLength": 1
        },
        "sslmode": {
          "enum": ["verify-full", "verify-ca", "require"]
        },
        "caSecret": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "pool": {
          "type": "object",
          "properties": {
            "minSize": {
              "type": "integer",
              "minimum": 0
            },
            "maxSize": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "migrator": {
          "type": "object",
          "required": ["existingSecret", "uriKey"],
          "properties": {
            "existingSecret": {
              "type": "string",
              "minLength": 1
            },
            "uriKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "otel": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "resourceAttributes": {
          "type": "string"
        }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "keepAliveSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 3600
        }
      }
    },
    "maintenance": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "minLength": 9
        }
      }
    }
  }
}
