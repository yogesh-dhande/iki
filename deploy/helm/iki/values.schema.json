{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "image",
    "environment",
    "publicUrl",
    "allowedHosts",
    "secretKey",
    "encryptionKeys",
    "database"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Deployment name, e.g. prod"
    },
    "plugins": {
      "type": "object",
      "properties": {
        "allowLocal": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^https?://[^/?#]+/?$",
      "description": "Base URL users open Iki at, e.g. https://iki.example.com"
    },
    "allowedHosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "https": {
      "type": "boolean"
    },
    "forwardedAllowIps": {
      "type": "string",
      "minLength": 1
    },
    "log": {
      "type": "object",
      "properties": {
        "level": {
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR"]
        },
        "format": {
          "enum": ["json", "console"]
        }
      }
    },
    "secretKey": {
      "type": "object",
      "required": ["existingSecret", "key"],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "encryptionKeys": {
      "type": "object",
      "required": ["existingSecret", "key"],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sessions": {
      "type": "object",
      "properties": {
        "idleTimeoutMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 10080
        },
        "maxAgeHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 720
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "rateLimitPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "clientWorkers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^$|^[0-9][0-9A-Za-z.+-]*$",
          "maxLength": 64
        },
        "autoUpdate": {
          "type": "boolean"
        },
        "downloadsUrl": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        }
      }
    },
    "oauth": {
      "type": "object",
      "properties": {
        "accessTokenMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440
        },
        "refreshTokenDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "clientMetadataDocuments": {
          "type": "boolean"
        }
      }
    },
    "email": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "urlKey": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string"
        },
        "allowPlaintext": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "existingSecret": {
            "minLength": 1
          }
        },
        "required": ["existingSecret"]
      },
      "then": {
        "properties": {
          "from": {
            "minLength": 3,
            "pattern": "@"
          }
        },
        "required": ["from"]
      }
    },
    "webhooks": {
      "type": "object",
      "properties": {
        "allowedNetworks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"
          }
        },
        "caSecret": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allowHttp": {
          "type": "boolean"
        }
      }
    },
    "files": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string",
          "pattern": "^([a-z0-9][a-z0-9.-]{1,61}[a-z0-9])?$"
        },
        "prefix": {
          "type": "string"
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "publicEndpoint": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "credentials": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "accessKeyIdKey": {
              "type": "string",
              "minLength": 1
            },
            "secretAccessKeyKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "maxUploadSize": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(B|kB|MB|GB|TB|KiB|MiB|GiB|TiB)$"
        },
        "registerLocations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^s3://[a-z0-9][a-z0-9.-]{1,61}[a-z0-9](/[^,]*)?$"
          }
        },
        "workerEndpoint": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["existingSecret", "uriKey", "sslmode", "migrator"],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "uriKey": {
          "type": "string",
          "minLength": 1
        },
        "sslmode": {
          "enum": ["verify-full", "verify-ca", "require"]
        },
        "caSecret": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "pool": {
          "type": "object",
          "properties": {
            "minSize": {
              "type": "integer",
              "minimum": 0
            },
            "maxSize": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "analystRole": {
          "type": "string",
          "pattern": "^([a-z_][a-z0-9_]{0,62})?$"
        },
        "migrator": {
          "type": "object",
          "required": ["existingSecret", "uriKey"],
          "properties": {
            "existingSecret": {
              "type": "string",
              "minLength": 1
            },
            "uriKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "otel": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "resourceAttributes": {
          "type": "string"
        }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "keepAliveSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 3600
        },
        "devServer": {
          "type": "boolean"
        }
      }
    },
    "tasks": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "graceSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "runSecrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "egressProxy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "allowedNetworks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"
          }
        },
        "upstreamProxy": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^(http://[^@/]+:[0-9]+/?)?$",
              "description": "Without credentials: put a URL with credentials in existingSecret."
            },
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "graceSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "maintenance": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "minLength": 9
        }
      }
    },
    "backendWorkers": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "enum": ["IfNotPresent", "Always", "Never"]
            }
          }
        },
        "registrationToken": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "serverUrl": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "scratch": {
          "type": "object",
          "properties": {
            "sizeLimit": {
              "type": "string",
              "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$"
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"]
          }
        },
        "allowHttp": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "https": {
            "const": true
          }
        },
        "required": ["https"]
      },
      "then": {
        "properties": {
          "webhooks": {
            "properties": {
              "allowHttp": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
