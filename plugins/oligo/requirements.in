# The oligonucleotide tools' packages. Compile the pinned, hashed requirements.txt from it
# (from this directory) with:
#
#   uv pip compile requirements.in --python-version 3.12 --universal --generate-hashes \
#     --exclude-newer "$(date -u -v-3d +%Y-%m-%dT%H:%M:%SZ)" -o requirements.txt
#
# and keep the same releases in the repository's dev dependencies (pyproject.toml),
# where its tests run: `make check-deps` checks they match.
#
# RDKit is BSD-3-Clause; its wheels bundle Boost (BSL-1.0) and the InChI Trust's InChI
# library (MIT). It needs numpy and Pillow. The same
# release as the small_molecule plugin's.
rdkit==2026.9.2
