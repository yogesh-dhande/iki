# The plasmid tools' packages: Biopython, to align the library's parts to a plasmid and
# to cut with its REBASE-derived restriction enzymes, and Wasmtime, to run the DNA
# library annotation module. Compile the pinned, hashed
# requirements.txt from it (from this directory) with:
#
#   uv pip compile requirements.in --python-version 3.12 --universal --generate-hashes \
#     --exclude-newer "$(date -u -v-3d +%Y-%m-%dT%H:%M:%SZ)" -o requirements.txt
#
# and keep the same release in the repository's dev dependencies (pyproject.toml),
# where its tests run: `make check-deps` checks they match.
biopython==1.88
wasmtime==50.0.1
