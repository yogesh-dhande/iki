# Allowlist: only what image builds need is sent to the Docker daemon.
*
!pyproject.toml
!uv.lock
!LICENSE
!NOTICE
!server/
!cli/
# The spec package, which the server installs (without its tests), and the
# codegen package and Python SDK: only what resolving the workspace needs.
!spec/pyproject.toml
!spec/README.md
!spec/LICENSE
!spec/NOTICE
!spec/src/
!codegen/pyproject.toml
!codegen/README.md
!codegen/LICENSE
!codegen/NOTICE
!sdk/python/pyproject.toml
!sdk/python/README.md
!sdk/python/LICENSE
!sdk/python/NOTICE
# The web app, built into the image by its own stage.
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!web/
**/node_modules/
web/**/dist/
# A local build would otherwise ride along; the image builds its own.
server/src/iki_server/web/static/app/
server/tests/
spec/tests/
# The worker, built by worker/Dockerfile, without its build output.
!worker/Cargo.toml
!worker/Cargo.lock
!worker/rust-toolchain.toml
!worker/crates/
worker/target/
**/__pycache__/
**/*.pyc
