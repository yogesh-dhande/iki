# Allowlist: only what image builds need is sent to the Docker daemon.
*
!pyproject.toml
!uv.lock
!LICENSE
!NOTICE
!server/
!cli/
# The spec package, which the server installs (without its tests), and the
# codegen package and Python SDK: only what resolving the workspace needs.
!spec/pyproject.toml
!spec/README.md
!spec/LICENSE
!spec/NOTICE
!spec/backend/
!spec/src/
!codegen/pyproject.toml
!codegen/README.md
!codegen/LICENSE
!codegen/NOTICE
!sdk/python/pyproject.toml
!sdk/python/README.md
!sdk/python/LICENSE
!sdk/python/NOTICE
# The web app, built into the image by its own stage.
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!scripts/build-dna-annotation-wasm.sh
!web/
**/node_modules/
web/**/dist/
# A local build would otherwise ride along; the image builds its own.
server/src/iki_server/web/static/app/
web/app/wasm/
**/*.wasm
spec/src/iki_spec/rust-standard-library.html
server/tests/
spec/tests/
# The worker, built by worker/Dockerfile, without its build output.
!worker/Cargo.toml
!worker/Cargo.lock
!worker/rust-toolchain.toml
!worker/.cargo/
!worker/crates/
worker/target/
# The scripts that build the plugins' modules in the wasm stage; no .wasm is sent, and
# the stage compares nothing, so no digest is sent either (ADR 0200).
!scripts/build-plasmid-tools-wasm.sh
**/__pycache__/
**/*.pyc
